  exam     Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  type     StimulusType @default(TEXT)
  title    String?
  content  String? // text / markdown / HTML body
  mediaUrl String? // image/audio/video/document URL
  caption  String?
  data     Json? // structured payload for TABLE / CHART types

  questions      Question[]
  questionGroups QuestionGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examId])
  @@index([type])
}

model QuestionGroup {
  id           String       @id @default(uuid())
  examId       String
  exam         Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  sectionId    String?
  section      ExamSection? @relation(fields: [sectionId], references: [id])
  stimulusId   String?
  stimulus     Stimulus?    @relation(fields: [stimulusId], references: [id])
  title        String?
  instructions String?
  orderIndex   Int          @default(0)

  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examId])
  @@index([sectionId])
  @@index([stimulusId])
}

model ExamAssignment {
  id              String             @id @default(uuid())
  examId          String
  exam            Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student            @relation(fields: [studentId], references: [id])
  accommodationId String?
  accommodation   ExamAccommodation? @relation(fields: [accommodationId], references: [id])

  availableFromOverride  DateTime?
  availableUntilOverride DateTime?
  attemptLimitOverride   Int?
  accessCodeOverride     String?
  invigilatorId          String? // User.id of assigned invigilator (no FK by design)
  status                 String    @default("ASSIGNED") // ASSIGNED | STARTED | COMPLETED | INVALIDATED

  attempts ExamAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@index([invigilatorId])
}

model ExamAccommodation {
  id        String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  examId    String?
  exam      Exam?   @relation(fields: [examId], references: [id])

  extraTimePercent   Float?
  extraTimeMinutes   Int?
  largerText         Boolean @default(false)
  highContrast       Boolean @default(false)
  screenReader       Boolean @default(false)
  reducedDistraction Boolean @default(false)
  calculatorAllowed  Boolean @default(false)
  additionalBreaks   Boolean @default(false)
  separateRoom       Boolean @default(false)
  readerSupport      Boolean @default(false)
  scribeSupport      Boolean @default(false)
  notes              String?

  assignments ExamAssignment[]
  attempts    ExamAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([examId])
}

model GradingRubric {
  id          String    @id @default(uuid())
  examId      String?
  exam        Exam?     @relation(fields: [examId], references: [id])
  questionId  String?
  question    Question? @relation(fields: [questionId], references: [id])
  title       String
  description String?
  maxScore    Float     @default(0)

  criteria     RubricCriterion[]
  manualGrades ManualGrade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examId])
  @@index([questionId])
}

model RubricCriterion {
  id          String        @id @default(uuid())
  rubricId    String
  rubric      GradingRubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  label       String
  description String?
  maxScore    Float         @default(0)
  orderIndex  Int           @default(0)
  levels      Json? // optional scoring bands: [{label, points, descriptor}]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rubricId])
}

model ManualGrade {
  id         String         @id @default(uuid())
  attemptId  String
  attempt    ExamAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question       @relation(fields: [questionId], references: [id])
  answerId   String?
  answer     ExamAnswer?    @relation(fields: [answerId], references: [id])
  rubricId   String?
  rubric     GradingRubric? @relation(fields: [rubricId], references: [id])

  assignedGraderId  String? // User.id the item is queued to
  graderId          String? // User.id who graded
  criterionScores   Json? // { rubricCriterionId: score }
  score             Float?
  inlineFeedback    Json? // [{ anchor, comment }]
  overallComment    String?
  scoreOverride     Float?
  overrideReason    String?
  secondMarkerId    String?
  secondMarkerScore Float?
  moderationComment String?
  status            String    @default("PENDING") // PENDING | IN_REVIEW | GRADED | MODERATED | FINALIZED
  isFinalized       Boolean   @default(false)
  finalizedAt       DateTime?
  finalizedById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attemptId])
  @@index([questionId])
  @@index([answerId])
  @@index([assignedGraderId])
  @@index([status])
}

model AttemptEvent {
  id        String      @id @default(uuid())
  attemptId String
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type      String // AUTOSAVE | NAVIGATE | PAUSE | RESUME | SUBMIT | AUTO_SUBMIT | DISCONNECT | RECONNECT | FOCUS_LOST | EXTRA_TIME | FORCE_SUBMIT | REOPEN | INVALIDATE | INCIDENT_NOTE | SESSION_TAKEOVER
  actorId   String? // User.id; null = the student/system
  actorRole String?
  payload   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([attemptId])
  @@index([type])
  @@index([createdAt])
}

model AttemptSnapshot {
  id               String      @id @default(uuid())
  attemptId        String
  attempt          ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  reason           String // AUTOSAVE | NAVIGATE | PAUSE | SUBMIT | FINAL
  answers          Json // frozen copy of all answers at snapshot time
  questionOrder    Json?
  remainingSeconds Int?
  createdAt        DateTime    @default(now())

  @@index([attemptId])
  @@index([createdAt])
}

model ExamResultPolicy {
  id                  String    @id @default(uuid())
  examId              String    @unique
  exam                Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  showScore           Boolean   @default(true)
  showPassFail        Boolean   @default(true)
  showCorrectAnswers  Boolean   @default(false)
  showExplanations    Boolean   @default(false)
  showTeacherFeedback Boolean   @default(true)
  releaseMode         String    @default("IMMEDIATE") // IMMEDIATE | SCHEDULED | AFTER_GRADING | HIDDEN
  releaseAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examId])
}

model QuestionStatistic {
  id         String   @id @default(uuid())
  questionId String   @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  attempts            Int      @default(0)
  correctCount        Int      @default(0)
  incorrectCount      Int      @default(0)
  blankCount          Int      @default(0)
  avgResponseSeconds  Float?
  difficultyIndex     Float? // p-value (mean proportion correct)
  discriminationIndex Float? // point-biserial / upper-lower
  distractorRates     Json? // { option: rate }
  avgScore            Float?
  medianScore         Float?
  stdDev              Float?
  passRate            Float?
  scoreDistribution   Json? // histogram buckets
  flags               String[] @default([]) // TOO_EASY | TOO_HARD | POOR_DISCRIMINATION | UNUSED_DISTRACTOR | SLOW | ABNORMAL_PATTERN

  computedAt DateTime @default(now())

  @@index([examId])
}

model QuestionBank {
  id          String  @id @default(uuid())
  name        String
  subjectId   String?
  description String?
  createdById String?

  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
}

model QuestionTopic {
  id        String          @id @default(uuid())
  name      String
  code      String?
  subjectId String?
  parentId  String?
  parent    QuestionTopic?  @relation("TopicTree", fields: [parentId], references: [id])
  children  QuestionTopic[] @relation("TopicTree")

  questions Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([subjectId])
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  weight     Float? // for partial-credit / multi-select scoring
  orderIndex Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
}

model ExamQuestion {
  id             String             @id @default(uuid())
  examId         String
  exam           Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sectionId      String?
  section        ExamSection?       @relation(fields: [sectionId], references: [id])
  pointsOverride Float?
  displayOrder   Int                @default(0)
  required       Boolean            @default(true)
  sourceType     ExamQuestionSource @default(FIXED)

  createdAt DateTime @default(now())

  @@unique([examId, questionId])
  @@index([examId])
  @@index([questionId])
  @@index([sectionId])
}

model ExamBlueprintRule {
  id         String              @id @default(uuid())
  examId     String
  exam       Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  sectionId  String?
  section    ExamSection?        @relation(fields: [sectionId], references: [id])
  subjectId  String?
  topicId    String?
  difficulty QuestionDifficulty?
  type       QuestionType?
  count      Int                 @default(1)
  pointsEach Float?

  createdAt DateTime @default(now())

  @@index([examId])
  @@index([sectionId])
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum PayrollStatus {
  DRAFT // run created, payslips editable
  APPROVED // locked, ready to pay
  PAID // disbursed
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Department {
  id           String        @id @default(uuid())
  name         String        @unique
  code         String?       @unique
  description  String?
  employees    Employee[]
  designations Designation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Designation {
  id           String      @id @default(uuid())
  title        String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  employees    Employee[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([departmentId])
}

model Employee {
  id              String         @id @default(uuid())
  userId          String?        @unique
  user            User?          @relation(fields: [userId], references: [id])
  employeeCode    String         @unique
  firstName       String
  lastName        String
  email           String?
  phone           String?
  status          EmployeeStatus @default(ACTIVE)
  hireDate        DateTime       @default(now())
  terminationDate DateTime?
  baseSalary      Float          @default(0)
  currency        String         @default("MYR")
  profilePhotoUrl String?

  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id])
  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id])

  payslips      Payslip[]
  leaveRequests LeaveRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeCode])
  @@index([departmentId])
  @@index([status])
}

model PayrollRun {
  id          String        @id @default(uuid())
  periodMonth Int // 1-12
  periodYear  Int
  status      PayrollStatus @default(DRAFT)
  notes       String?
  createdById String?
  payslips    Payslip[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([periodYear, periodMonth])
  @@index([status])
}

model Payslip {
  id           String     @id @default(uuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   String?
  employee     Employee?  @relation(fields: [employeeId], references: [id])
  teacherId    String?
  teacher      Teacher?   @relation(fields: [teacherId], references: [id])
  baseSalary   Float      @default(0)
  allowances   Float      @default(0)
  deductions   Float      @default(0)
  netPay       Float      @default(0)
  currency     String     @default("MYR")
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([payrollRunId, employeeId])
  @@unique([payrollRunId, teacherId])
  @@index([employeeId])
  @@index([teacherId])
}

model LeaveType {
  id          String         @id @default(uuid())
  name        String         @unique
  daysPerYear Int            @default(0) // 0 = uncapped / unpaid
  paid        Boolean        @default(true)
  requests    LeaveRequest[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model LeaveRequest {
  id             String             @id @default(uuid())
  employeeId     String
  employee       Employee           @relation(fields: [employeeId], references: [id])
  leaveTypeId    String
  leaveType      LeaveType          @relation(fields: [leaveTypeId], references: [id])
  startDate      DateTime
  endDate        DateTime
  days           Float
  reason         String?
  status         LeaveRequestStatus @default(PENDING)
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────────
// EXPENSE MANAGEMENT MODELS
// ────────────────────────────────────────────────────────────────────────────────

model Expense {
  id String @id @default(uuid())

  // Basic Information
  title       String
  description String?
  category    ExpenseCategory
  status      ExpenseStatus   @default(DRAFT)

  // Financial Details
  amount      Float
  currency    String  @default("MYR")
  taxAmount   Float?  @default(0)
  totalAmount Float? // amount + taxAmount (computed)
  budgetId    String? // Link to budget for tracking

  // Vendor Information
  vendorId        String?
  vendor          Vendor? @relation(fields: [vendorId], references: [id])
  vendorInvoiceNo String? @unique

  // Dates
  expenseDate DateTime
  dueDate     DateTime?
  paidDate    DateTime?

  // Payment Information
  paymentMethod    PaymentMethod?
  paymentReference String?        @unique // Check number, transfer reference, etc.
  bankAccount      String? // Which school bank account was used

  // Approval Workflow
  submittedById   String?
  submittedByName String?
  submittedAt     DateTime?
  approvedById    String?
  approvedByName  String?
  approvedAt      DateTime?
  rejectionReason String?

  // Supporting Documents
  receiptUrl         String?
  receiptFileName    String?
  attachmentUrls     String[] @default([])
  attachmentMetadata Json? // Array of {fileName, fileSize, mimeType}

  // Additional Details
  notes              String?
  tags               String[] @default([])
  isRecurring        Boolean  @default(false)
  recurringExpenseId String? // If generated from recurring expense

  // Academic Context
  academicYear String?
  term         String?

  // Class/Department tracking
  departmentId     String?
  relatedClassId   String?
  relatedSubjectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  payments         BillPayment[]
  recurringExpense RecurringExpense? @relation("ExpenseToRecurring", fields: [recurringExpenseId], references: [id])
  budget           Budget?           @relation(fields: [budgetId], references: [id])

  @@index([category])
  @@index([status])
  @@index([expenseDate])
  @@index([dueDate])
  @@index([vendorId])
  @@index([budgetId])
  @@index([submittedById])
  @@index([academicYear])
  @@index([term])
  @@index([isRecurring])
  @@index([createdAt])
}

model Vendor {
  id String @id @default(uuid())

  // Basic Information
  name        String
  code        String? @unique // Auto-generated vendor code
  description String?

  // Contact Information
  contactPerson String?
  email         String?
  phone         String?
  website       String?

  // Address
  address    String?
  city       String?
  state      String?
  postalCode String?
  country    String? @default("Malaysia")

  // Tax & Banking
  taxId        String? // GST/VAT/Tax registration number
  bankName     String?
  bankAccount  String?
  paymentTerms String? // e.g., "NET 30", "COD"

  // Categorization
  category String? // e.g., "Food Supplier", "IT Services"
  tags     String[] @default([])

  // Status
  isActive Boolean @default(true)

  // Performance Tracking
  totalPurchases   Float     @default(0)
  purchaseCount    Int       @default(0)
  lastPurchaseDate DateTime?

  // Audit
  notes         String?
  createdById   String?
  createdByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@index([name])
  @@index([code])
  @@index([category])
  @@index([isActive])
  @@index([createdAt])
}

model BillPayment {
  id String @id @default(uuid())

  // Reference
  expenseId     String
  expense       Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  paymentNumber String  @unique // Auto-generated: PAY-2024-0001

  // Payment Details
  amount        Float
  currency      String        @default("MYR")
  paymentMethod PaymentMethod
  paymentDate   DateTime      @default(now())

  // Reference Information
  referenceNumber String? // Check number, transfer ref
  bankAccount     String? // Which school account paid

  // Supporting Documents
  receiptUrl      String?
  receiptFileName String?

  // Approval
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?

  // Additional
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expenseId])
  @@index([paymentDate])
  @@index([paymentMethod])
  @@index([paymentNumber])
}

model RecurringExpense {
  id String @id @default(uuid())

  // Basic Information
  title       String
  description String?
  category    ExpenseCategory
  status      ExpenseStatus   @default(DRAFT)

  // Financial Details
  amount      Float
  currency    String @default("MYR")
  taxAmount   Float? @default(0)
  totalAmount Float? // amount + taxAmount

  // Vendor Information
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  // Recurring Schedule
  frequency       RecurringExpenseFrequency
  startDate       DateTime
  endDate         DateTime?
  dayOfMonth      Int? // For monthly: 1-31, or -1 for last day
  occurrenceCount Int? // Total number of occurrences (null = indefinite)

  // Payment Information
  paymentMethod PaymentMethod?
  budgetId      String?

  // Approval
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?

  // Tracking
  nextOccurrenceDate DateTime?
  lastGeneratedDate  DateTime?
  totalGenerated     Int       @default(0)

  // Additional
  notes String?
  tags  String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  generatedExpenses Expense[] @relation("ExpenseToRecurring")

  @@index([category])
  @@index([status])
  @@index([frequency])
  @@index([startDate])
  @@index([endDate])
  @@index([nextOccurrenceDate])
  @@index([createdAt])
}

model Budget {
  id String @id @default(uuid())

  // Basic Information
  name        String
  code        String?      @unique // Budget code like "OP-2024-Q1"
  description String?
  status      BudgetStatus @default(ACTIVE)

  // Budget Period
  fiscalYear Int
  startDate  DateTime
  endDate    DateTime

  // Allocation
  allocatedAmount Float
  currency        String @default("MYR")
  spentAmount     Float  @default(0)
  remainingAmount Float  @default(0) // computed: allocated - spent

  // Categorization
  category     ExpenseCategory?
  departmentId String?

  // Constraints
  alertThreshold Float   @default(0.8) // Alert when 80% spent
  strictLimit    Boolean @default(false) // Block expenses if exceeded

  // Approval
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?

  // Additional
  notes String?
  tags  String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  expenses Expense[]
  feeItems FeeItem[]

  @@index([name])
  @@index([code])
  @@index([status])
  @@index([fiscalYear])
  @@index([category])
  @@index([departmentId])
  @@index([startDate])
  @@index([endDate])
}

// -----------------------------------------------------------------------------
// STUDENT DUTY SYSTEM (boarding-school chore rosters: cooking, cleaning, etc.)
// Note: performance stats (completion rate, average rating, points) are
// deliberately NOT a stored model here -- they're computed live from
// DutyAssignment via GET /api/duty-performance/:studentId. A cached/stored
// summary table is exactly the kind of thing that silently drifts from the
// real numbers (see Budget.spentAmount elsewhere in this schema, which had
// that bug), and duty history is cheap enough to aggregate on read.
// -----------------------------------------------------------------------------

model DutyDefinition {
  id               String   @id @default(uuid())
  name             String
  code             String   @unique // Auto-generated: DUTY-001
  type             DutyType
  description      String?
  durationMinutes  Int? // Expected time to complete
  requiredStudents Int      @default(1) // How many students needed per occurrence
  pointsAwarded    Int      @default(1)
  isActive         Boolean  @default(true)
  notes            String?

  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignments DutyAssignment[]

  @@index([type])
  @@index([isActive])
}

model DutyRoster {
  id              String           @id @default(uuid())
  name            String // e.g. "Week 45", "November 2026"
  periodType      String           @default("WEEKLY") // WEEKLY, MONTHLY, TERMLY
  startDate       DateTime
  endDate         DateTime
  status          DutyRosterStatus @default(DRAFT)
  maxWeeklyDuties Int              @default(5) // Fairness cap used by auto-assign
  notes           String?

  publishedAt     DateTime?
  publishedById   String?
  publishedByName String?

  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignments DutyAssignment[]

  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model DutyAssignment {
  id String @id @default(uuid())

  rosterId String
  roster   DutyRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)

  dutyDefinitionId String
  dutyDefinition   DutyDefinition @relation(fields: [dutyDefinitionId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  scheduledDate DateTime
  status        DutyStatus @default(ASSIGNED)

  // Completion & performance
  rating       Int? // 1-5, set when marking COMPLETED
  pointsEarned Int?
  completedAt  DateTime?
  ratedById    String?
  ratedByName  String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rosterId])
  @@index([dutyDefinitionId])
  @@index([studentId])
  @@index([scheduledDate])
  @@index([status])
}

// -----------------------------------------------------------------------------
// SOCIAL SPACE (24h posts + curated class snapshots and video highlights)
// -----------------------------------------------------------------------------

enum SocialPostType {
  POST
  CLASS_SNAPSHOT
  VIDEO_HIGHLIGHT
}

enum SocialAudience {
  SCHOOL
  CLASS
  STAFF
}

enum SocialPublishStatus {
  DRAFT
  PUBLISHED
}

model SocialPost {
  id            String              @id @default(uuid())
  authorId      String
  author        User                @relation("SocialAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  type          SocialPostType      @default(POST)
  audience      SocialAudience      @default(SCHOOL)
  publishStatus SocialPublishStatus @default(PUBLISHED)
  body          String?
  imageUrl      String?
  classId       String?
  class         Class?              @relation(fields: [classId], references: [id], onDelete: SetNull)
  videoLessonId String?
  videoLesson   VideoLesson?        @relation(fields: [videoLessonId], references: [id], onDelete: SetNull)
  featuredUntil DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  expiresAt     DateTime?

  likes    SocialLike[]
  comments SocialComment[]
  reports  SocialReport[]
  media    SocialMediaAsset[]

  @@index([authorId])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([type, publishStatus, createdAt])
  @@index([audience, classId])
  @@index([videoLessonId])
}

model SocialLike {
  id        String         @id @default(uuid())
  postId    String
  post      SocialPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation("SocialLiker", fields: [userId], references: [id], onDelete: Cascade)
  // FB/IG-style reaction. Defaults to LIKE so existing rows keep working
  // after the column is added; a user's single row per post flips between
  // reaction types (or is removed entirely) as they tap the picker.
  reaction  SocialReaction @default(LIKE)
  createdAt DateTime       @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([postId, reaction])
}

// Ordered media attachments for a post (photos only for now; video stays
// via the existing VideoLesson highlight flow). `imageUrl` on SocialPost is
// kept as a denormalised cover (the first asset's url) so the existing feed
// query and the /uploads/social auth gate keep working unchanged.
model SocialMediaAsset {
  id        String     @id @default(uuid())
  postId    String
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  // 0-based display order within the post; the carousel honours this.
  position  Int        @default(0)
  width     Int?
  height    Int?
  mime      String?
  createdAt DateTime   @default(now())

  @@index([postId, position])
}

enum SocialReaction {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
  ANGRY
}

model SocialComment {
  id        String     @id @default(uuid())
  postId    String
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation("SocialCommenter", fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime   @default(now())
  // Set the first time the author edits this comment; null means never
  // edited. Surfaced in the UI as a small "(edited)" tag.
  editedAt  DateTime?

  reports SocialReport[]

  @@index([postId])
}

enum SocialReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

// A user flagging a post or comment for admin review -- mirrors the
// ChatMessageReport pattern used for Chat moderation. Exactly one of
// postId/commentId is set per report.
model SocialReport {
  id           String             @id @default(uuid())
  postId       String?
  post         SocialPost?        @relation(fields: [postId], references: [id], onDelete: SetNull)
  commentId    String?
  comment      SocialComment?     @relation(fields: [commentId], references: [id], onDelete: SetNull)
  reportedById String
  reportedBy   User               @relation("SocialReporter", fields: [reportedById], references: [id], onDelete: Cascade)
  reason       String?
  status       SocialReportStatus @default(OPEN)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())

  // A user can only report a given post/comment once -- report again by
  // filing on a different item.
  @@unique([postId, reportedById])
  @@unique([commentId, reportedById])
  @@index([status])
  @@index([postId])
  @@index([commentId])
}

// Tracks the last time each user viewed the Social Space feed, so the app
// can badge new posts/comments from other people the same way Chat badges
// unread messages.
model SocialSeen {
  userId     String   @id
  user       User     @relation("SocialSeenBy", fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// CHAT (conversation-based messaging)
// -----------------------------------------------------------------------------

enum ConversationType {
  DIRECT
  GROUP
  CLASS_CHANNEL
}

enum ChatReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

model Conversation {
  id            String           @id @default(uuid())
  type          ConversationType @default(DIRECT)
  title         String?
  classId       String?
  createdById   String
  createdBy     User             @relation("ConversationCreatedBy", fields: [createdById], references: [id])
  lastMessageAt DateTime         @default(now())

  participants ConversationParticipant[]
  messages     ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  lastReadAt     DateTime?
  isMuted        Boolean      @default(false)
  leftAt         DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  attachmentUrl  String?
  expiresAt      DateTime? // set for ephemeral camera photos (disappear after 24h)
  deletedAt      DateTime?

  reports ChatMessageReport[]

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model ChatMessageReport {
  id           String           @id @default(uuid())
  messageId    String
  message      ChatMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reportedById String
  reason       String?
  status       ChatReportStatus @default(OPEN)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())

  @@index([status])
  @@index([messageId])
}

// ── News / Daily Digest ──────────────────────────────────────────────────────
// Admin-managed list of RSS feeds. Articles are aggregated from these on a
// scheduled refresh (see server.ts scheduleNewsRefresh). `content` is only
// populated when the publisher's own feed includes full-article HTML (e.g.
// content:encoded) — we never scrape the source page to force full text, so
// students read in-app when the feed offers it, and read at the source
// (credited, linked) when it doesn't.
model NewsSource {
  id            String    @id @default(uuid())
  name          String
  feedUrl       String    @unique
  category      String? // free-text label, e.g. "World", "Education", "Science"
  enabled       Boolean   @default(true)
  lastFetchedAt DateTime?
  lastError     String?
  createdById   String?

  articles NewsArticle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsArticle {
  id       String     @id @default(uuid())
  sourceId String
  source   NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  title       String
  summary     String?
  content     String? // full-article HTML, only when the feed provides it (e.g. content:encoded)
  link        String // original article URL — the credited source, always shown
  imageUrl    String?
  author      String?
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())

  createdAt DateTime @default(now())

  @@unique([sourceId, link])
  @@index([publishedAt])
  @@index([sourceId])
}

// -----------------------------------------------------------------------------
// SNAKE GAME (educational mini-game for students)
// -----------------------------------------------------------------------------

model SnakeGameScore {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String?
  className String?

  score     Int
  highScore Boolean @default(false) // Whether this was a personal best at the time
  gameMode  String  @default("CLASSIC") // CLASSIC | VOCABULARY | COMPETITION

  // Game details
  speed        String @default("NORMAL") // SLOW | NORMAL | FAST
  gridSize     Int    @default(20)
  gameDuration Int // seconds

  // Vocabulary mode details
  vocabularyWords Int      @default(0) // Words learned in vocabulary mode
  wordsList       String[] @default([]) // List of words encountered

  // Competition details
  competitionId String? // If part of a weekly competition
  competition   SnakeCompetition? @relation(fields: [competitionId], references: [id])
  rank          Int? // Rank in competition

  deviceInfo Json? // User agent, screen size, etc.
  ipAddress  String?

  playedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([classId])
  @@index([score])
  @@index([gameMode])
  @@index([competitionId])
  @@index([playedAt])
}

model SnakeCompetition {
  id String @id @default(uuid())

  title       String
  description String?

  classId   String?
  className String?

  competitionType String @default("WEEKLY") // WEEKLY | MONTHLY | SPECIAL
  status          String @default("ACTIVE") // DRAFT | ACTIVE | COMPLETED | CANCELLED

  startDate DateTime
  endDate   DateTime

  // Participation
  participantCount Int @default(0)

  // Prizes
  prizes Json? // [{rank, description, badgeKey}]

  createdById   String?
  createdByName String?

  scores SnakeGameScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

// CHECKERS GAME (educational mini-game for students)
// -----------------------------------------------------------------------------

model CheckerGameScore {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String?
  className String?

  // For tracking wins/losses/draws
  result    String  @default("PLAYING") // WIN | LOSE | DRAW | PLAYING | ABANDONED
  score     Int     @default(0) // Points earned (pieces captured + bonuses)
  highScore Boolean @default(false) // Whether this was a personal best at the time

  gameMode String @default("CLASSIC") // CLASSIC | VOCABULARY | PVP

  // Game details
  opponentType String  @default("HUMAN") // HUMAN | AI | CPU
  difficulty   String? // EASY | MEDIUM | HARD (for AI games)
  gameDuration Int // seconds
  movesCount   Int     @default(0) // Total moves made in the game

  // Pieces captured
  playerPiecesCaptured   Int @default(0)
  opponentPiecesCaptured Int @default(0)
  playerKingsEarned      Int @default(0)
  opponentKingsEarned    Int @default(0)

  // Vocabulary mode details
  vocabularyWords Int      @default(0) // Words learned in vocabulary mode
  wordsList       String[] @default([]) // List of words encountered

  deviceInfo Json? // User agent, screen size, etc.
  ipAddress  String?

  playedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([classId])
  @@index([score])
  @@index([gameMode])
  @@index([playedAt])
  @@index([result])
}

// Teacher/admin-authored vocabulary for the Checkers vocabulary game. These are
// mixed with the built-in English–Myanmar dictionary when building quizzes, so
// staff can curate class-specific words that reach every student.
model CheckerVocabularyWord {
  id           String  @id @default(uuid())
  word         String
  definition   String
  partOfSpeech String? // noun | verb | adjective | ...
  difficulty   String  @default("medium") // easy | medium | hard
  language     String  @default("en")
  active       Boolean @default(true) // soft-hide instead of delete when false

  createdById   String? // User.id of the teacher/admin who added it
  createdByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([word])
}

// CHESS GAME — online multiplayer (educational mini-game)
// -----------------------------------------------------------------------------
// A single row covers the full lifecycle of one game between two people:
// challenge sent (PENDING) → accepted (ACTIVE) → finished (FINISHED), or
// DECLINED/CANCELLED if the challenge never turned into a game. The board is
// authoritative on the server — `fen` is the current position and `moves` is
// the SAN history — so a client can never spoof a move; every move is
// re-validated server-side with chess.js before being applied.
//
// Players are keyed by User (not Student) so both students (matched with
// classmates) and staff/teachers (matched with any other staff member,
// school-wide) can use the same feature. `scope` records which pool a match
// belongs to and a student can never end up matched against a staff member.
model ChessMatch {
  id String @id @default(uuid())

  whiteId String
  white   User   @relation("ChessWhite", fields: [whiteId], references: [id], onDelete: Cascade)
  blackId String
  black   User   @relation("ChessBlack", fields: [blackId], references: [id], onDelete: Cascade)

  // User.id of whichever side sent the invite — lets the UI show "X
  // challenged you" vs. "waiting for X to accept" without extra lookups.
  challengerId String

  scope String @default("STUDENT") // STUDENT | STAFF — which pool this game belongs to

  // Only set (and only meaningful) for STUDENT-scope matches, so classmates
  // can be grouped/labelled. Staff matches are school-wide and leave these null.
  classId   String?
  className String?

  status String @default("PENDING") // PENDING | ACTIVE | FINISHED | DECLINED | CANCELLED

  fen       String   @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
  moves     String[] @default([]) // SAN history, in order
  turnColor String   @default("w") // "w" | "b" — whose move it is right now

  result       String? // WHITE_WINS | BLACK_WINS | DRAW
  resultReason String? // CHECKMATE | RESIGNATION | STALEMATE | REPETITION | INSUFFICIENT_MATERIAL | FIFTY_MOVE | DECLINED | ABANDONED

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  respondedAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?
  lastMoveAt  DateTime?

  @@index([whiteId])
  @@index([blackId])
  @@index([status])
  @@index([scope])
  @@index([classId])
  @@index([updatedAt])
}

// -----------------------------------------------------------------------------
// LANGUAGE QUEST — game-like language courses for every authenticated role
// -----------------------------------------------------------------------------

model LanguageQuestCourse {
  id          String  @id @default(uuid())
  code        String  @unique
  title       String
  description String?
  language    String
  category    String  @default("Other Courses")
  imageEmoji  String  @default("🌍")
  accentColor String  @default("#7c3aed")
  published   Boolean @default(false)

  // Kept as a scalar rather than a relation so courses survive account cleanup.
  // Null identifies an official/system-provided course.
  createdById String?

  units        LanguageQuestUnit[]
  userProgress LanguageQuestUserProgress[]
  classrooms   LanguageQuestClassroom[]
  xpEvents     LanguageQuestXpEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([category])
  @@index([createdById])
}

model LanguageQuestUnit {
  id          String              @id @default(uuid())
  courseId    String
  course      LanguageQuestCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int

  lessons LanguageQuestLesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, order])
  @@index([courseId])
}

model LanguageQuestLesson {
  id          String            @id @default(uuid())
  unitId      String
  unit        LanguageQuestUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int

  challenges LanguageQuestChallenge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, order])
  @@index([unitId])
}

model LanguageQuestChallenge {
  id       String              @id @default(uuid())
  lessonId String
  lesson   LanguageQuestLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type     String              @default("SELECT") // SELECT | ASSIST
  question String
  order    Int

  options  LanguageQuestOption[]
  progress LanguageQuestChallengeProgress[]
  mastery  LanguageQuestMasteryProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, order])
  @@index([lessonId])
}

model LanguageQuestOption {
  id          String                 @id @default(uuid())
  challengeId String
  challenge   LanguageQuestChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  text        String
  correct     Boolean                @default(false)
  emoji       String?
  audioText   String?
  order       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([challengeId, order])
  @@index([challengeId])
}

model LanguageQuestUserProgress {
  id             String               @id @default(uuid())
  userId         String               @unique
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCourseId String?
  activeCourse   LanguageQuestCourse? @relation(fields: [activeCourseId], references: [id], onDelete: SetNull)
  hearts         Int                  @default(5)
  points         Int                  @default(0)
  currentStreak  Int                  @default(0)
  bestStreak     Int                  @default(0)
  lastPlayedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([points])
  @@index([activeCourseId])
}

model LanguageQuestChallengeProgress {
  id              String                 @id @default(uuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId     String
  challenge       LanguageQuestChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  completed       Boolean                @default(false)
  attempts        Int                    @default(0)
  correctAttempts Int                    @default(0)
  wrongAttempts   Int                    @default(0)
  completedAt     DateTime?
  lastAttemptAt   DateTime               @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, challengeId])
  @@index([userId])
  @@index([challengeId])
  @@index([completed])
}

model LanguageQuestXpEvent {
  id         String               @id @default(uuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String?
  course     LanguageQuestCourse? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  source     String
  sourceId   String?
  points     Int
  occurredAt DateTime             @default(now())

  @@index([userId, occurredAt])
  @@index([courseId, occurredAt])
  @@index([source, occurredAt])
}

model LanguageQuestMasteryProgress {
  id             String                 @id @default(uuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId    String
  challenge      LanguageQuestChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  stage          Int                    @default(0)
  dueAt          DateTime
  lastReviewedAt DateTime?
  correctReviews Int                    @default(0)
  wrongReviews   Int                    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, challengeId])
  @@index([userId, dueAt])
  @@index([challengeId])
}

model LanguageQuestMissionClaim {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionKey String
  periodKey  String
  rewardXp   Int
  claimedAt  DateTime @default(now())

  @@unique([userId, missionKey, periodKey])
  @@index([userId, claimedAt])
}

model LanguageQuestClassroom {
  id            String                            @id @default(uuid())
  name          String
  teacherId     String
  teacher       User                              @relation("LanguageQuestClassroomTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  joinCode      String                            @unique
  focusCourseId String?
  focusCourse   LanguageQuestCourse?              @relation(fields: [focusCourseId], references: [id], onDelete: SetNull)
  active        Boolean                           @default(true)
  members       LanguageQuestClassroomMember[]
  challenges    LanguageQuestClassroomChallenge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, active])
  @@index([focusCourseId])
}

model LanguageQuestClassroomChallenge {
  id          String                 @id @default(uuid())
  classroomId String
  classroom   LanguageQuestClassroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetXp    Int
  rewardLabel String?
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean                @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classroomId, active, endsAt])
}

model LanguageQuestClassroomMember {
  id          String                 @id @default(uuid())
  classroomId String
  classroom   LanguageQuestClassroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime               @default(now())

  @@unique([classroomId, userId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// DAILY LEARNING QUEST — one English vocabulary session per student/teacher/day
// -----------------------------------------------------------------------------

model DailyQuestSession {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey       String
  mode         String    @default("STANDARD") // RELAXED | STANDARD | CHALLENGE
  status       String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  items        Json
  answers      Json?
  currentIndex Int       @default(0)
  correctCount Int       @default(0)
  pointsEarned Int       @default(0)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, dayKey])
  @@index([userId, status])
  @@index([dayKey, status])
  @@index([pointsEarned])
}

// -----------------------------------------------------------------------------
// WORD TRAIL — server-authoritative English vocabulary board game
// -----------------------------------------------------------------------------

model WordTrailGame {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeKey     String?   @unique
  status        String    @default("ACTIVE") // ACTIVE | WON | LOST | ABANDONED
  position      Int       @default(0)
  hearts        Int       @default(4)
  score         Int       @default(0)
  turnCount     Int       @default(0)
  correctCount  Int       @default(0)
  wrongCount    Int       @default(0)
  currentStreak Int       @default(0)
  bestStreak    Int       @default(0)
  lastRoll      Int?
  questionDeck  Json
  pendingTurn   Json?
  answerHistory Json?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, score])
  @@index([completedAt])
}

// -----------------------------------------------------------------------------
// GAME PARENTAL CONTROLS — server-enforced limits for student recreation
// -----------------------------------------------------------------------------

model GameControlPolicy {
  id                  String  @id @default(uuid())
  scope               String // GLOBAL | CLASS | STUDENT
  scopeKey            String // GLOBAL | CLASS:<id> | STUDENT:<id>
  gameKey             String // ALL | SNAKE | SUDOKU | CHECKERS | CHESS | PACMAN | WORD_TRAIL
  enabled             Boolean @default(true)
  blocked             Boolean @default(false)
  dailyLimitMinutes   Int?
  sessionLimitMinutes Int?
  cooldownMinutes     Int     @default(0)
  allowedDays         Int[]   @default([])
  allowedStartMinute  Int?
  allowedEndMinute    Int?
  note                String?
  managedByRole       Role

  classId     String?
  class       Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId   String?
  student     Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation("GameControlCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User     @relation("GameControlUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scopeKey, gameKey])
  @@index([classId])
  @@index([studentId])
  @@index([gameKey, enabled])
}

model GamePlaySession {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameKey         String
  status          String    @default("ACTIVE") // ACTIVE | ENDED | LIMIT_REACHED | REVOKED
  startedAt       DateTime  @default(now())
  lastHeartbeatAt DateTime  @default(now())
  endedAt         DateTime?
  consumedSeconds Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, gameKey, startedAt])
}

model GameDailyUsage {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameKey String
  dayKey  String
  seconds Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameKey, dayKey])
  @@index([userId, dayKey])
}
