  substituteTeacherName String?
  academicYear          String?
  term                  String?
  dayOfWeek             String
  startTime             String
  endTime               String
  room                  String?
  scheduleType          String    @default("CLASS") // CLASS | HOLIDAY | SPECIAL_EVENT | EXAM | MEETING
  recurrence            String    @default("WEEKLY") // ONCE | WEEKLY | BIWEEKLY
  effectiveFrom         DateTime?
  effectiveUntil        DateTime?
  status                String    @default("ACTIVE") // ACTIVE | CANCELLED | SUBSTITUTED
  cancellationReason    String?
  eventDate             DateTime?
  notes                 String?

  attendances Attendance[] @relation("SessionAttendance")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
  @@index([teacherId])
  @@index([substituteTeacherId])
  @@index([dayOfWeek])
  @@index([academicYear])
  @@index([term])
  @@index([room])
  @@index([status])
  @@index([scheduleType])
}

model StudentDocument {
  id             String    @id @default(uuid())
  studentId      String
  title          String
  documentType   String    @default("OTHER") // UNHCR | PASSPORT | BIRTH_CERTIFICATE | SCHOOL_RECORD | GUARDIAN_DOC | MEDICAL | OTHER
  fileUrl        String
  fileName       String
  fileSize       Int       @default(0)
  mimeType       String    @default("application/octet-stream")
  expiryDate     DateTime?
  uploadedById   String?
  uploadedByName String?
  status         String    @default("ACTIVE") // ACTIVE | ARCHIVED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([documentType])
  @@index([status])
}

enum GradeCategoryType {
  ASSIGNMENT
  QUIZ
  MIDTERM
  FINAL
  MOCK_GED
}

enum GedSubjectArea {
  RLA
  MATH
  SCIENCE
  SOCIAL_STUDIES
}

enum GedReadinessStatus {
  NOT_READY
  DEVELOPING
  NEAR_READY
  READY
  TEST_SCHEDULED
  PASSED
}

model GradeItem {
  id       String            @id @default(uuid())
  title    String
  category GradeCategoryType
  maxMarks Float             @default(100)
  date     DateTime          @default(now())

  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  createdById String?
  grades      Grade[]

