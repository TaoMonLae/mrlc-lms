model HomeworkSubmission {
  id         String   @id @default(uuid())
  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  text          String?
  attachmentUrl String?
  submittedAt   DateTime @default(now())

  status     String    @default("SUBMITTED") // SUBMITTED | MARKED | REDO
  score      Float? // optional — only when the teacher chooses to score
  feedback   String?
  markedAt   DateTime?
  markedById String?

  attachments HomeworkSubmissionAttachment[]
  updatedAt   DateTime                       @updatedAt

  @@unique([homeworkId, studentId])
  @@index([studentId])
}

model HomeworkSubmissionAttachment {
  id           String             @id @default(uuid())
  submissionId String
  submission   HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  url          String             @unique
  originalName String
  mimeType     String
  size         Int
  uploadedAt   DateTime           @default(now())

  @@index([submissionId])
}

// -----------------------------------------------------------------------------
// FLASHCARDS (teacher-authored study decks assigned to classes)
// -----------------------------------------------------------------------------

model FlashcardDeck {
  id          String  @id @default(uuid())
  title       String
  description String?
  // Opt-in: when true, other teachers can find this deck in the Community
  // tab and clone it into their own library. Off by default so a teacher's
  // decks stay private unless they choose to share.
  shared      Boolean @default(false)

  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  cards      FlashcardCard[]
  classLinks FlashcardDeckClass[]
  attempts   FlashcardAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
}

model FlashcardCard {
  id         String        @id @default(uuid())
  deckId     String
  deck       FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  term       String
  definition String
  imageUrl   String?
  order      Int           @default(0)
  createdAt  DateTime      @default(now())

  masteries FlashcardCardMastery[]

  @@index([deckId])
}

// A student's personal "know it" / "still learning" flag on one card,
// independent of any quiz/match/spelling score -- lets Study mode filter
// down to just the cards a student hasn't mastered yet.
model FlashcardCardMastery {
  id        String        @id @default(uuid())
  studentId String
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cardId    String
  card      FlashcardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  status    String        @default("LEARNING") // LEARNING | KNOWN
  updatedAt DateTime      @updatedAt

  @@unique([studentId, cardId])
  @@index([cardId])
}

// A single completed play of Quiz, Match, or Spelling mode, so students can
// see their history and teachers can see who's actually engaging with a
// deck. For MATCH, score/total represent (pairs solved without a mistake)
// out of (total pairs); durationMs holds the completion time.
model FlashcardAttempt {
  id         String        @id @default(uuid())
  studentId  String
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  deckId     String
  deck       FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  mode       String // QUIZ | SPELL | MATCH
  score      Int
  total      Int
  durationMs Int?
  createdAt  DateTime      @default(now())

  @@index([deckId])
  @@index([studentId])
}

// Which classes a deck has been assigned to -- a teacher may reuse one deck
// across several classes/sections they teach.
model FlashcardDeckClass {
  id      String        @id @default(uuid())
  deckId  String
  deck    FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  classId String
  class   Class         @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([deckId, classId])
  @@index([classId])
}

model Grade {
  id          String    @id @default(uuid())
  gradeItemId String
  gradeItem   GradeItem @relation(fields: [gradeItemId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  marks       Float?
  comment     String?
  gradedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gradeItemId, studentId])
  @@index([studentId])
}

model CategoryWeight {
  id       String            @id @default(uuid())
  classId  String
  class    Class             @relation(fields: [classId], references: [id])
  category GradeCategoryType
  weight   Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, category])
  @@index([classId])
}

model GedReadiness {
  id          String             @id @default(uuid())
  studentId   String
  student     Student            @relation(fields: [studentId], references: [id])
  subject     GedSubjectArea
  status      GedReadinessStatus @default(NOT_READY)
  note        String?
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subject])
  @@index([studentId])
}

model StudentBadge {
  id           String   @id @default(uuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badgeKey     String // e.g. "STREAK_7", "FIRST_EXAM"
  level        Int      @default(1)
  earnedAt     DateTime @default(now())
  currentCount Int      @default(0) // For multi-level badges (e.g. current streak length)
  targetCount  Int? // Target for next level
  metadata     Json? // Additional context

  @@unique([studentId, badgeKey])
  @@index([studentId])
  @@index([badgeKey])
}

enum DocumentType {
  REPORT_CARD
  TRANSCRIPT
  ENROLLMENT_CONFIRMATION
  COMPLETION_CERTIFICATE
  PROGRESS_REPORT
}

enum DocumentStatus {
  ACTIVE
  CANCELLED
  REISSUED
}

model GeneratedDocument {
  id             String         @id @default(uuid())
  documentNumber String         @unique
  verifyToken    String         @unique
  type           DocumentType
  status         DocumentStatus @default(ACTIVE)

  studentId   String
  student     Student @relation(fields: [studentId], references: [id])
  studentName String
  studentCode String
  className   String?
  term        String?

  payload      Json?
  issuedById   String?
  issuedByName String?
  issueDate    DateTime @default(now())

  reissuedFromId  String?
  cancelledReason String?
  downloadCount   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, type, term, status])
  @@index([studentId])
  @@index([type])
  @@index([status])
}

model Message {
  id      String   @id @default(uuid())
  subject String
  body    String
  sentAt  DateTime @default(now())

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id])

  recipients MessageRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId])
  @@index([sentAt])
}

model MessageRecipient {
  id        String  @id @default(uuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   User   @relation("ReceivedMessages", fields: [recipientId], references: [id])

  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, recipientId])
  @@index([messageId])
  @@index([recipientId])
  @@index([readAt])
}

model SavedReport {
  id          String  @id @default(uuid())
  name        String
  description String?
  reportType  String // "attendance" | "exams" | "students" | "fees"

  // Report configuration
  filters Json // Store query parameters (classId, month, etc.)

  // Audit
  generatedById   String
  generatedByName String?

  // Generation tracking
  lastGeneratedAt DateTime?
  generationCount Int       @default(0)

  generations ReportGeneration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportType])
  @@index([generatedById])
}

model ReportGeneration {
  id            String       @id @default(uuid())
  savedReportId String?
  savedReport   SavedReport? @relation(fields: [savedReportId], references: [id])

  reportType String
  reportName String
  filters    Json

  // Status
  status String @default("COMPLETED") // PENDING | COMPLETED | FAILED

  // Output
  fileUrl  String?
  fileSize Int?

  // Audit
  generatedById   String
  generatedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([savedReportId])
  @@index([reportType])
  @@index([generatedById])
  @@index([status])
  @@index([createdAt])
}

model LessonPlan {
  id          String  @id @default(uuid())
  title       String
  description String?

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  // Schedule
  plannedDate DateTime
  duration    Int      @default(60) // minutes
  room        String?

  // Content
  objectives String[]
  materials  String[]
  activities String[]
  assessment String?

  // Status
  status String @default("DRAFT") // DRAFT | SCHEDULED | COMPLETED | CANCELLED

  // Audit
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  progress LessonPlanProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([plannedDate])
  @@index([status])
}

model LessonPlanProgress {
  id           String     @id @default(uuid())
  lessonPlanId String
  lessonPlan   LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)

  week          Int
  topicsCovered String[]
  notes         String?
  completed     Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonPlanId, week])
  @@index([lessonPlanId])
  @@index([week])
}

model ExamSection {
  id               String  @id @default(uuid())
  examId           String
  exam             Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  instructions     String?
  orderIndex       Int     @default(0)
  timeLimitMinutes Int?
  shuffleQuestions Boolean @default(false)
  questionsToPick  Int? // if set, randomly pick N questions from the section pool

  questions      Question[]
  questionGroups QuestionGroup[]
  examQuestions  ExamQuestion[]
  blueprintRules ExamBlueprintRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examId])
  @@index([orderIndex])
}

model Stimulus {
