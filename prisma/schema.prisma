generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  STAFF
  ACCOUNTANT
  CASE_WORKER
  LIBRARIAN
}

enum BookLoanStatus {
  BORROWED
  RETURNED
  OVERDUE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
  MOCK
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
  MCQ
  WRITTEN
  GED_RLA_PASSAGE
  GED_MATH
  GED_SCIENCE
  GED_SOCIAL_STUDIES
  DRAG_DROP
  DROPDOWN
  HOTSPOT
  EXTENDED
}

enum FeeStatus {
  PAID
  PENDING
  OVERDUE
  WAIVED
  PARTIAL
}

enum FeeStructureStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FeeFrequency {
  ONE_TIME // Single payment
  MONTHLY // Monthly recurring
  TERMLY // Per academic term
  YEARLY // Annual
}

enum FeeDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  SIBLING_DISCOUNT
  SCHOLARSHIP
  EARLY_PAYMENT
}

enum InstallmentStatus {
  PENDING
  DUE
  PAID
  OVERDUE
  WAIVED
}

enum StimulusType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  TABLE
  CHART
  DOCUMENT
}

enum AttemptState {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  SUBMITTED
  AUTO_SUBMITTED
  PENDING_GRADING
  FINALIZED
  RELEASED
  INVALIDATED
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  RETIRED
  ARCHIVED
}

enum ExamQuestionSource {
  FIXED
  RANDOM
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  RESOLVED
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  URGENT
}

// ────────────────────────────────────────────────────────────────────────────────
// EXPENSE MANAGEMENT ENUMS
// ────────────────────────────────────────────────────────────────────────────────

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIAL // some, but not all, of the expense's total has been paid via BillPayment records
  PAID
  REJECTED
  CANCELLED
}

enum ExpenseCategory {
  OPERATIONAL // Daily operations, utilities, maintenance
  ACADEMIC // Educational materials, supplies, equipment
  STAFF_COSTS // Employee-related expenses (excluding payroll)
  FOOD_CATERING // Boarding school meals, events
  TRANSPORTATION // Vehicle costs, fuel, travel
  FACILITY // Building repairs, improvements
  TECHNOLOGY // IT equipment, software, licenses
  EVENT // School events, activities
  ADMINISTRATIVE // Office supplies, insurance, legal
  OTHER // Miscellaneous expenses
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  CREDIT_CARD
  DEBIT_CARD
  ONLINE_PAYMENT
  WIRE_TRANSFER
  OTHER
}

enum RecurringExpenseFrequency {
  DAILY
  WEEKLY
  BI_WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUALLY
}

enum BudgetStatus {
  ACTIVE
  EXHAUSTED
  EXCEEDED
  ARCHIVED
}

// ────────────────────────────────────────────────────────────────────────────────
// STUDENT DUTY SYSTEM ENUMS
// ────────────────────────────────────────────────────────────────────────────────

enum DutyType {
  COOKING
  RESOURCE_BUYING
  CLEANING
  DISH_WASHING
  GARDENING
  MAINTENANCE
  SECURITY
  EVENT_SETUP
  OTHER
}

enum DutyStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  EXCUSED
  FAILED
}

enum DutyRosterStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  ARCHIVED
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  username              String?   @unique
  passwordHash          String?
  firstName             String
  lastName              String
  profilePhotoUrl       String?
  // Personal override for the decorative mouse-cursor effect. Null means
  // "use the school-wide default" set in Settings > System > Cursor Effects.
  cursorEffect          String?
  role                  Role      @default(STUDENT)
  isActive              Boolean   @default(true)
  // Public self-signups are learning-only accounts. They use the STUDENT role
  // for Language Quest progress, but are isolated from private school modules.
  isExternalLearner     Boolean   @default(false)
  mustChangePassword    Boolean   @default(false)
  lastLoginAt           DateTime?
  mfaEnabled            Boolean   @default(false)
  mfaSecretEncrypted    String?
  mfaRecoveryCodeHashes String[]  @default([])
  mfaEnrolledAt         DateTime?

  studentProfile         Student?
  teacherProfile         Teacher?
  employeeProfile        Employee?
  recordedAttendances    Attendance[]            @relation("RecordedBy")
  caseNotes              CaseNote[]
  sentMessages           Message[]               @relation("SentMessages")
  receivedMessages       MessageRecipient[]      @relation("ReceivedMessages")
  assignedInterventions  InterventionPlan[]      @relation("InterventionAssignee")
  createdInterventions   InterventionPlan[]      @relation("InterventionCreator")
  notifications          Notification[]
  notificationPreference NotificationPreference?
  authSessions           AuthSession[]
  passwordResetTokens    PasswordResetToken[]
  queuedEmails           EmailOutbox[]

  conversationsCreated       Conversation[]                   @relation("ConversationCreatedBy")
  conversationParticipations ConversationParticipant[]
  chatMessages               ChatMessage[]
  socialPosts                SocialPost[]                     @relation("SocialAuthor")
  socialLikes                SocialLike[]                     @relation("SocialLiker")
  socialComments             SocialComment[]                  @relation("SocialCommenter")
  socialSeen                 SocialSeen?                      @relation("SocialSeenBy")
  socialReportsFiled         SocialReport[]                   @relation("SocialReporter")
  reportedRuleViolations     RuleViolation[]                  @relation("ReportedRuleViolations")
  chessMatchesWhite          ChessMatch[]                     @relation("ChessWhite")
  chessMatchesBlack          ChessMatch[]                     @relation("ChessBlack")
  languageQuestProgress      LanguageQuestUserProgress?
  languageQuestChallenges    LanguageQuestChallengeProgress[]
  languageQuestXpEvents      LanguageQuestXpEvent[]
  languageQuestMastery       LanguageQuestMasteryProgress[]
  languageQuestMissionClaims LanguageQuestMissionClaim[]
  languageQuestAvatar        String                           @default("owl")
  languageQuestBio           String?
  languageQuestClassrooms    LanguageQuestClassroom[]         @relation("LanguageQuestClassroomTeacher")
  languageQuestMemberships   LanguageQuestClassroomMember[]
  dailyQuestSessions         DailyQuestSession[]
  wordTrailGames             WordTrailGame[]
  gameControlPoliciesCreated GameControlPolicy[]              @relation("GameControlCreatedBy")
  gameControlPoliciesUpdated GameControlPolicy[]              @relation("GameControlUpdatedBy")
  gamePlaySessions           GamePlaySession[]
  gameDailyUsage             GameDailyUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([username])
  @@index([isExternalLearner])
}

model SchoolProfile {
  id              String  @id @default(uuid())
  name            String
  shortName       String?
  address         String?
  contactEmail    String?
  contactPhone    String?
  website         String?
  academicYear    String?
  principalName   String?
  description     String?
  establishedYear Int?

  // Branding
  logoUrl           String?
  signatureUrl      String?
  loginHeroUrl      String?
  primaryColor      String? @default("#5865f2")
  accentColor       String? @default("#3b82f6")
  darkModeDefault   Boolean @default(false)
  reportHeaderStyle String? @default("standard")

  // System / localization
  timezone                      String? @default("Asia/Bangkok")
  dateFormat                    String? @default("DD/MM/YYYY")
  currency                      String? @default("THB")
  defaultLanguage               String? @default("en")
  fileUploadLimitMb             Int     @default(10)
  backupEnabled                 Boolean @default(true)
  lockdownBrowserEnabled        Boolean @default(true)
  lockdownRequireFullscreen     Boolean @default(true)
  lockdownBlockClipboard        Boolean @default(true)
  lockdownBlockContextMenu      Boolean @default(true)
  lockdownBlockShortcuts        Boolean @default(true)
  lockdownAutoSubmitOnViolation Boolean @default(true)
  lockdownMaxWarnings           Int     @default(3)
  lockdownInstructions          String?

  // Fun/decorative — global mouse-pointer effect for the whole app.
  // NONE | RAINBOW_TRAIL | SPLASH_CURSOR | RIBBONS
  cursorEffect String? @default("RAINBOW_TRAIL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id                           String    @id @default(uuid())
  userId                       String?   @unique
  user                         User?     @relation(fields: [userId], references: [id])
  studentCode                  String    @unique
  preferredName                String?
  dateOfBirth                  DateTime?
  enrollmentDate               DateTime  @default(now())
  guardianName                 String?
  guardianRelationship         String?
  guardianPhone                String?
  guardianEmail                String?
  contactNumber                String?
  country                      String?
  identityType                 String?
  identityNumber               String?
  legalDocumentationStatus     String?
  address                      String?
  emergencyContact             String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  previousSchool               String?
  previousEducationLevel       String?
  educationLevel               String?
  medicalInformation           String?
  allergies                    String?
  notes                        String?
  gender                       String?
  profilePhotoUrl              String?
  status                       String?   @default("ACTIVE")

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  attendances         Attendance[]
  examAttempts        ExamAttempt[]
  feePayments         FeePayment[]
  feeAssignments      FeeAssignment[]
  paymentPlans        FeePaymentPlan[]
  caseRecords         CaseRecord[]
  grades              Grade[]
  gedReadiness        GedReadiness[]
  documents           GeneratedDocument[]
  examAssignments     ExamAssignment[]
  examAccommodations  ExamAccommodation[]
  homeworkSubmissions HomeworkSubmission[]
  badges              StudentBadge[]
  dutyAssignments     DutyAssignment[]
  flashcardMastery    FlashcardCardMastery[]
  flashcardAttempts   FlashcardAttempt[]
  ruleViolations      RuleViolation[]
  interventions       InterventionPlan[]
  snakeGameScores     SnakeGameScore[]
  checkerGameScores   CheckerGameScore[]
  gameControlPolicies GameControlPolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentCode])
  @@index([classId])
}

model Teacher {
  id              String   @id @default(uuid())
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id])
  teacherCode     String   @unique
  hireDate        DateTime @default(now())
  specialization  String?
  profilePhotoUrl String?
  baseSalary      Float    @default(0)
  currency        String   @default("MYR")
  phone           String?
  gender          String?
  address         String?
  employmentType  String   @default("FULL_TIME")
  notes           String?

  classes        ClassTeacher[]
  subjects       SubjectTeacher[]
  lessonPlans    LessonPlan[]
  payslips       Payslip[]
  homework       Homework[]
  flashcardDecks FlashcardDeck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherCode])
}

model Class {
  id           String  @id @default(uuid())
  name         String
  level        String // e.g., "GED", "Pre-GED"
  academicYear String
  room         String?
  capacity     Int?
  description  String?
  status       String  @default("ACTIVE")

  students            Student[]
  teachers            ClassTeacher[]
  subjects            ClassSubject[]
  exams               Exam[]
  attendances         Attendance[]
  gradeItems          GradeItem[]
  categoryWeights     CategoryWeight[]
  lessonPlans         LessonPlan[]
  homework            Homework[]
  flashcardDeckLinks  FlashcardDeckClass[]
  socialPosts         SocialPost[]
  gameControlPolicies GameControlPolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Intermediary table for Teacher <-> Class (Many-to-Many)
model ClassTeacher {
  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  @@id([classId, teacherId])
  @@index([teacherId])
  @@index([classId])
}

// Intermediary table for Class <-> Subject (Many-to-Many)
model ClassSubject {
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([classId, subjectId])
  @@index([subjectId])
  @@index([classId])
}

model Subject {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  description String?
  level       String  @default("GED")
  status      String  @default("ACTIVE")

  teachers       SubjectTeacher[]
  classes        ClassSubject[]
  exams          Exam[]
  gradeItems     GradeItem[]
  lessonPlans    LessonPlan[]
  homework       Homework[]
  flashcardDecks FlashcardDeck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Intermediary table for Teacher <-> Subject
model SubjectTeacher {
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  @@id([subjectId, teacherId])
  @@index([teacherId])
  @@index([subjectId])
}

model Attendance {
  id      String           @id @default(uuid())
  date    DateTime         @default(now()) // Also serves as eventDate for sessions
  status  AttendanceStatus
  remarks String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  classId   String
  class     Class   @relation(fields: [classId], references: [id])

  // Session-based attendance fields (optional, for session-based tracking)
  timetableEntryId String? // Links to TimetableEntry for session-based attendance
  timetableEntry   TimetableEntry? @relation("SessionAttendance", fields: [timetableEntryId], references: [id])
  subjectId        String? // Denormalized from timetableEntry for easier queries

  recordedById String
  recordedBy   User   @relation("RecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique constraint: For class-based attendance (timetableEntryId is null),
  // ensures one record per student per class per date.
  // For session-based attendance (timetableEntryId is set),
  // application-level validation ensures one record per student per session per date.
  @@unique([studentId, classId, date])
  @@index([studentId])
  @@index([classId])
  @@index([date])
  @@index([timetableEntryId])
  @@index([subjectId])
}

model Exam {
  id              String   @id @default(uuid())
  title           String
  type            ExamType
  status          String   @default("PUBLISHED") // DRAFT | SCHEDULED | ACTIVE | CLOSED | ARCHIVED | PUBLISHED
  date            DateTime
  durationMinutes Int?
  totalMarks      Float?
  settings        Json?

  // Phase 2 scheduling
  availableFrom       DateTime?
  availableUntil      DateTime?
  resultReleaseAt     DateTime?
  attemptLimit        Int       @default(1)
  gracePeriodMinutes  Int       @default(0)
  allowLateStart      Boolean   @default(true)
  requiresAccessCode  Boolean   @default(false)
  accessCodeHash      String?
  requiresInvigilator Boolean   @default(false)

  // Phase 2 delivery / scoring options
  shuffleQuestions Boolean @default(false)
  shuffleOptions   Boolean @default(false)
  negativeMarking  Boolean @default(false)
  passMark         Float?

  // Phase 3: cloning provenance
  clonedFromId String?

  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  questions Question[]
  attempts  ExamAttempt[]

  // Phase 2 relations
  sections       ExamSection[]
  stimuli        Stimulus[]
  questionGroups QuestionGroup[]
  assignments    ExamAssignment[]
  accommodations ExamAccommodation[]
  rubrics        GradingRubric[]
  resultPolicy   ExamResultPolicy?
  questionStats  QuestionStatistic[]

  // Phase 3 relations
  examQuestions  ExamQuestion[]
  blueprintRules ExamBlueprintRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
  @@index([subjectId])
  @@index([status])
  @@index([availableFrom])
  @@index([availableUntil])
}

model Question {
  id            String       @id @default(uuid())
  text          String
  type          QuestionType
  points        Float
  options       Json? // Optional for multiple choice
  correctAnswer String? // Can be an option string or detailed answer
  explanation   String? // Shown only after result release
  passageText   String? // Optional passage text (e.g. for GED RLA/Science/Social Studies split layout)
  imageUrl      String? // Optional image/media shown with the question

  // Phase 2: structure
  orderIndex Int            @default(0)
  sectionId  String?
  section    ExamSection?   @relation(fields: [sectionId], references: [id])
  groupId    String?
  group      QuestionGroup? @relation(fields: [groupId], references: [id])
  stimulusId String?
  stimulus   Stimulus?      @relation(fields: [stimulusId], references: [id])

  // Phase 2: partial-credit / scoring config
  correctAnswers        Json? // multiple accepted text answers
  optionWeights         Json? // per-option weighting for multi-select partial scoring
  negativePoints        Float? // negative marking magnitude (positive number)
  minScore              Float? // minimum score floor for this question
  numericTolerance      Float? // tolerance for numeric answers
  caseSensitive         Boolean @default(false)
  partialCredit         Boolean @default(false)
  requiresManualGrading Boolean @default(false)

  examId String?
  exam   Exam?   @relation(fields: [examId], references: [id], onDelete: Cascade)

  // Phase 3: reusable question bank fields
  bankId               String?
  bank                 QuestionBank?       @relation(fields: [bankId], references: [id])
  subjectId            String?
  topicId              String?
  topic                QuestionTopic?      @relation(fields: [topicId], references: [id])
  subtopic             String?
  difficulty           QuestionDifficulty?
  defaultPoints        Float?
  estimatedTimeSeconds Int?
  status               QuestionStatus      @default(DRAFT)
  version              Int                 @default(1)
  tags                 String[]            @default([])
  language             String?
  createdById          String?
  reviewedById         String?
  approvedAt           DateTime?
  archivedAt           DateTime?

  answers      ExamAnswer[]
  rubrics      GradingRubric[]
  manualGrades ManualGrade[]
  statistic    QuestionStatistic?
  optionRows   QuestionOption[]
  examLinks    ExamQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examId])
  @@index([sectionId])
  @@index([groupId])
  @@index([stimulusId])
  @@index([bankId])
  @@index([subjectId])
  @@index([topicId])
  @@index([status])
  @@index([difficulty])
}

model ExamAttempt {
  id               String    @id @default(uuid())
  score            Float?
  isCompleted      Boolean   @default(false)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  securityWarnings Int       @default(0)
  autoSubmitted    Boolean   @default(false)
  integrityEvents  Json?

  // Phase 2: lifecycle state machine
  state         AttemptState @default(NOT_STARTED)
  attemptNumber Int          @default(1)

  // Phase 2: server-authoritative timing
  serverDeadline           DateTime? // absolute time the attempt must end (authoritative)
  effectiveDurationMinutes Int? // base duration + accommodation extra time
  pausedAt                 DateTime?
  accumulatedPauseSeconds  Int       @default(0)
  lastSavedAt              DateTime?
  submittedAt              DateTime?
  gradedAt                 DateTime?
  releasedAt               DateTime?
  invalidatedAt            DateTime?
  gradingStatus            String? // PENDING | IN_REVIEW | COMPLETE

  // Phase 2: single-session + integrity
  sessionToken  String? // active session; mismatched tokens are rejected
  questionOrder Json? // frozen randomized order for this attempt
  ipAddress     String?
  userAgent     String?
  deviceInfo    Json?

  // Phase 3: randomized-selection freezing (set once at start, never regenerated)
  selectedQuestionIds Json? // the exact question IDs chosen for this attempt
  optionOrder         Json? // { questionId: [optionId|value, ...] } shuffled order
  randomSeed          String? // reproducible seed used for this attempt
  frozenContent       Json? // snapshot of question text + options as shown (historic fidelity)

  studentId       String
  student         Student            @relation(fields: [studentId], references: [id])
  examId          String
  exam            Exam               @relation(fields: [examId], references: [id])
  assignmentId    String?
  assignment      ExamAssignment?    @relation(fields: [assignmentId], references: [id])
  accommodationId String?
  accommodation   ExamAccommodation? @relation(fields: [accommodationId], references: [id])

  answers      ExamAnswer[]
  events       AttemptEvent[]
  snapshots    AttemptSnapshot[]
  manualGrades ManualGrade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, examId, attemptNumber])
  @@index([studentId])
  @@index([examId])
  @@index([state])
  @@index([assignmentId])
}

model ExamAnswer {
  id               String   @id @default(uuid())
  answerText       String?
  selectedOptions  Json? // for multi-select questions
  isCorrect        Boolean?
  pointsAwarded    Float? // final awarded points (auto + manual)
  autoScore        Float? // machine-scored component
  manualScore      Float? // grader-assigned component
  maxPoints        Float?
  flaggedForReview Boolean  @default(false) // student self-flag
  timeSpentSeconds Int?
  gradingState     String? // NOT_REQUIRED | PENDING | GRADED

  attemptId  String
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id])

  manualGrades ManualGrade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model LibraryResource {
  id              String  @id @default(uuid())
  title           String
  author          String?
  isbn            String?
  type            String // e.g., "BOOK", "DIGITAL", "EQUIPMENT"
  totalCopies     Int     @default(1)
  availableCopies Int     @default(1)
  description     String?
  visibility      String? @default("ALL")
  classId         String?
  subjectId       String?
  externalUrl     String?

  // Enhanced metadata
  fileSize       Int?
  mimeType       String?
  downloadCount  Int       @default(0)
  lastDownloaded DateTime?

  // Organization
  category     String?
  tags         String[] @default([])
  subjectAreas String[] @default([])
  gradeLevels  String[] @default([])

  // Audit
  uploadedById   String?
  uploadedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([visibility])
  // The /uploads/library auth gate looks resources up by externalUrl to check
  // visibility before serving a file; index it so every file fetch is cheap.
  @@index([externalUrl])
}

model FeePayment {
  id             String    @id @default(uuid())
  // Net amount owed for this charge, i.e. after discountAmount is
  // subtracted from the original gross amount quoted to the family.
  amount         Float
  // Amount knocked off the gross charge (e.g. sibling/scholarship
  // discount applied manually when recording the charge). Informational --
  // the gross amount billed is amount + discountAmount.
  discountAmount Float     @default(0)
  // How much of `amount` has actually been paid so far. A charge can be
  // recorded with paidAmount < amount (a partial payment), and topped up
  // later via POST /api/fees/:id/pay until paidAmount reaches amount.
  paidAmount     Float     @default(0)
  currency       String    @default("MYR")
  dueDate        DateTime
  paidDate       DateTime?
  status         FeeStatus @default(PENDING)
  description    String?
  receiptNumber  String?   @unique
  paymentMethod  String?
  notes          String?

  studentId     String
  student       Student         @relation(fields: [studentId], references: [id])
  assignmentId  String?         @unique
  assignment    FeeAssignment?  @relation("FeeAssignmentPayments", fields: [assignmentId], references: [id])
  installmentId String?         @unique
  installment   FeeInstallment? @relation("FeeInstallmentPayments", fields: [installmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([assignmentId])
  @@index([installmentId])
}

model FeeStructure {
  id                String             @id @default(uuid())
  name              String
  description       String?
  academicYear      Int
  term              String? // e.g., "Term 1", "Semester 1"
  status            FeeStructureStatus @default(DRAFT)
  currency          String             @default("MYR")
  effectiveFromDate DateTime
  effectiveToDate   DateTime?

  // Configuration
  applyToClasses     Boolean @default(false)
  applyToBoarders    Boolean @default(false)
  applyToDayStudents Boolean @default(false)

  notes String?
  tags  String[] @default([])

  // Audit
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  items        FeeItem[]
  assignments  FeeAssignment[]
  discounts    FeeDiscount[]
  paymentPlans FeePaymentPlan[]

  @@index([status])
  @@index([academicYear])
  @@index([effectiveFromDate])
}

model FeeItem {
  id          String       @id @default(uuid())
  name        String
  description String?
  amount      Float
  currency    String       @default("MYR")
  frequency   FeeFrequency @default(ONE_TIME)

  // Applicability
  applicableTo String   @default("ALL") // ALL, BOARDING_STUDENTS, DAY_STUDENTS
  classIds     String[] @default([]) // Empty = applies to all classes

  // Timing
  dueDate           DateTime?
  dueDaysAfterStart Int? // For recurring fees

  // Optional linking to budget
  budgetId String?
  budget   Budget? @relation(fields: [budgetId], references: [id])

  order    Int     @default(0)
  isActive Boolean @default(true)

  // Audit
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  feeStructureId String
  feeStructure   FeeStructure    @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  assignments    FeeAssignment[]

  @@index([feeStructureId])
  @@index([isActive])
}

model FeeAssignment {
  id        String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  feeItemId String
  feeItem   FeeItem @relation(fields: [feeItemId], references: [id])

  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])

  // Calculated amounts
  baseAmount     Float
  discountAmount Float @default(0)
  totalAmount    Float

  // Payment tracking
  paidAmount        Float @default(0)
  outstandingAmount Float

  // Status
  status   FeeStatus @default(PENDING)
  dueDate  DateTime
  paidDate DateTime?

  // Link to actual payment
  feePaymentId String?     @unique
  feePayment   FeePayment? @relation("FeeAssignmentPayments")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([feeItemId])
  @@index([feeStructureId])
  @@index([status])
  @@index([dueDate])
}

model FeeDiscount {
  id           String          @id @default(uuid())
  name         String
  description  String?
  discountType FeeDiscountType
  value        Float // Percentage or fixed amount

  // Applicability
  applyToAllStructures Boolean  @default(false)
  feeStructureIds      String[] @default([])
  classIds             String[] @default([])

  // Conditions
  minSiblings     Int? // For sibling discount
  requireBoarding Boolean @default(false)
  minGpa          Float? // For scholarships

  // Validity
  validFrom DateTime
  validTo   DateTime?
  isActive  Boolean   @default(true)

  // Audit
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@index([feeStructureId])
  @@index([isActive])
  @@index([validFrom])
}

model FeePaymentPlan {
  id          String  @id @default(uuid())
  name        String
  description String?

  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  // Financials
  totalAmount Float
  currency    String @default("MYR")

  // Installment configuration
  numberOfInstallments Int
  installmentFrequency String   @default("MONTHLY")
  firstInstallmentDue  DateTime

  // Status
  status InstallmentStatus @default(PENDING)

  // Agreement
  agreedById   String?
  agreedByName String?
  agreedAt     DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  installments FeeInstallment[]

  @@index([studentId])
  @@index([feeStructureId])
  @@index([status])
}

model FeeInstallment {
  id            String         @id @default(uuid())
  paymentPlanId String
  paymentPlan   FeePaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)

  installmentNumber Int
  amount            Float
  dueDate           DateTime
  paidDate          DateTime?
  status            InstallmentStatus @default(DUE)

  // Link to actual payment
  feePaymentId String?     @unique
  feePayment   FeePayment? @relation("FeeInstallmentPayments")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentPlanId])
  @@index([status])
  @@index([dueDate])
}

// ───────────────────────────────────────────────────────────────────────────────
// DONATION TRACKING (fundraising and alumni donations)
// ───────────────────────────────────────────────────────────────────────────────

enum DonationStatus {
  PENDING
  RECEIVED
  PROCESSED
  CANCELLED
  REFUNDED
}

enum DonationType {
  ONE_TIME
  RECURRING_MONTHLY
  RECURRING_QUARTERLY
  RECURRING_YEARLY
  IN_KIND
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Donor {
  id String @id @default(uuid())

  // Basic Information
  donorCode    String  @unique // Auto-generated: DON-YYYY-NNNN
  name         String
  email        String?
  phone        String?
  organization String? // Company or organization name (if donating as entity)

  // Classification
  donorType String  @default("INDIVIDUAL") // INDIVIDUAL, ORGANIZATION, ALUMNUS, PARENT, GRANT_AGENCY
  category  String? // e.g., "Major Donor", "Regular Supporter"

  // Contact Information
  address    String?
  city       String?
  state      String?
  postalCode String?
  country    String? @default("Malaysia")

  // Communication Preferences
  preferredContact String? @default("EMAIL") // EMAIL, PHONE, MAIL
  doNotContact     Boolean @default(false)
  isActive         Boolean @default(true)

  // Financial Information
  taxId             String? // For tax-deductible receipts
  receiptPreference String? @default("EMAIL") // EMAIL, MAIL, NONE

  // Additional
  notes String?
  tags  String[] @default([])

  // Audit
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  donations Donation[]

  @@index([donorCode])
  @@index([email])
  @@index([donorType])
  @@index([organization])
}

model Donation {
  id String @id @default(uuid())

  // Basic Information
  donationNumber String @unique // Auto-generated: DON-YYYY-NNNN
  amount         Float
  currency       String @default("MYR")

  // Classification
  donationType DonationType   @default(ONE_TIME)
  status       DonationStatus @default(PENDING)

  // Purpose
  purpose     String? // General, Scholarship, Building, Equipment, etc.
  designation String? // Specific fund or program

  // Relationships
  donorId String
  donor   Donor  @relation(fields: [donorId], references: [id])

  campaignId String?
  campaign   DonationCampaign? @relation(fields: [campaignId], references: [id])

  // Payment Information
  paymentMethod    String? // CASH, BANK_TRANSFER, CHECK, CREDIT_CARD, ONLINE
  paymentReference String? // Check number, transaction ID, etc.
  receiptNumber    String? @unique

  // Dates
  donationDate  DateTime  @default(now())
  receivedDate  DateTime?
  processedDate DateTime?

  // Tax Information
  isTaxDeductible  Boolean @default(true)
  taxReceiptAmount Float?

  // Additional
  notes              String?
  acknowledgmentSent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  receipt DonationReceipt?

  @@index([donorId])
  @@index([campaignId])
  @@index([status])
  @@index([donationDate])
  @@index([donationNumber])
}

model DonationCampaign {
  id String @id @default(uuid())

  // Basic Information
  name        String
  description String?
  goalAmount  Float
  currency    String         @default("MYR")
  status      CampaignStatus @default(DRAFT)

  // Campaign Period
  startDate DateTime
  endDate   DateTime

  // Target
  targetAudience String? // ALUMNI, PARENTS, CORPORATE, PUBLIC, STAFF

  // Progress Tracking
  raisedAmount Float @default(0)
  donorCount   Int   @default(0)

  // Additional
  coverImage String?
  notes      String?
  tags       String[] @default([])

  // Audit
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  donations Donation[]

  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model DonationReceipt {
  id String @id @default(uuid())

  // References
  donationId String   @unique
  donation   Donation @relation(fields: [donationId], references: [id])

  // Receipt Information
  receiptNumber String   @unique
  receiptDate   DateTime @default(now())

  // Recipient Information
  recipientName    String // Name on receipt
  recipientAddress String?
  recipientEmail   String?

  // Financial
  amount   Float
  currency String @default("MYR")

  // Tax Information
  isTaxDeductible     Boolean @default(true)
  taxDeductibleAmount Float?
  taxId               String?

  // Additional
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receiptNumber])
  @@index([receiptDate])
}

enum RuleSeverity {
  MINOR
  MODERATE
  SERIOUS
}

// Catalog of the school's numbered rules (School Rules & Regulations /
// Hostel Guidelines handbook), grouped by Article, so violations reference a
// real rule instead of free text. Seeded from the handbook via migration.
model ConductRule {
  id           String       @id @default(uuid())
  code         String       @unique // handbook numbering, e.g. "2", "20", "4.1a"
  article      String // e.g. "Article 1 — General Conduct"
  articleOrder Int // sort order for grouping by article in the UI
  title        String // short label, e.g. "Late to class"
  description  String // full rule text from the handbook
  severity     RuleSeverity @default(MINOR)
  active       Boolean      @default(true)

  violations RuleViolation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleOrder])
  @@index([severity])
}

// A single logged instance of a student breaking a specific rule. Deliberately
// simple for phase 1 (catalog + logging + counts) -- escalation workflow,
// guardian notices, and case-linking are later phases.
model RuleViolation {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  ruleId   String
  rule     ConductRule  @relation(fields: [ruleId], references: [id])
  // Snapshot of the rule's severity at the time of the violation, so a later
  // change to the rule catalog's severity doesn't rewrite history.
  severity RuleSeverity

  note       String?
  occurredAt DateTime @default(now())

  reportedById   String
  reportedBy     User   @relation("ReportedRuleViolations", fields: [reportedById], references: [id])
  reportedByName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([ruleId])
  @@index([occurredAt])
}

model CaseRecord {
  id          String       @id @default(uuid())
  title       String
  description String
  status      CaseStatus   @default(OPEN)
  priority    CasePriority @default(MEDIUM)
  category    String? // e.g., "ACADEMIC", "DISCIPLINE", "WELFARE"

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  notes CaseNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([status])
}

model CaseNote {
  id      String @id @default(uuid())
  content String

  caseRecordId String
  caseRecord   CaseRecord @relation(fields: [caseRecordId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseRecordId])
  @@index([createdById])
}

model InterventionPlan {
  id           String    @id @default(uuid())
  title        String
  reason       String
  priority     String    @default("MEDIUM")
  status       String    @default("OPEN")
  dueDate      DateTime?
  notes        String?
  outcome      String?
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?     @relation("InterventionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User      @relation("InterventionCreator", fields: [createdById], references: [id])
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([studentId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
}

model Notification {
  id         String                 @id @default(uuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  href       String?
  sourceId   String?
  readAt     DateTime?
  createdAt  DateTime               @default(now())
  deliveries NotificationDelivery[]

  @@unique([userId, sourceId])
  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inAppEnabled          Boolean  @default(true)
  homeworkReminders     Boolean  @default(true)
  resultNotifications   Boolean  @default(true)
  interventionReminders Boolean  @default(true)
  emailEnabled          Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model NotificationDelivery {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        String       @default("IN_APP")
  status         String       @default("QUEUED")
  attempts       Int          @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, channel, createdAt])
  @@index([notificationId])
}

model AuthSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress  String?
  userAgent  String?
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt, expiresAt])
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
}

model EmailOutbox {
  id            String    @id @default(uuid())
  dedupeKey     String?   @unique
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  toEmail       String
  subject       String
  textBody      String?
  htmlBody      String?
  status        String    @default("QUEUED")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt, createdAt])
  @@index([userId])
}

model VideoLesson {
  id             String    @id @default(uuid())
  title          String
  description    String?
  videoUrl       String
  thumbnailUrl   String?
  captionsUrl    String? // WebVTT subtitle track (uploaded videos)
  duration       Int? // seconds
  classId        String?
  subjectId      String?
  visibility     String    @default("ALL") // ALL | STUDENTS | TEACHERS_ONLY
  status         String    @default("PUBLISHED") // PUBLISHED | DRAFT | ARCHIVED
  isRequired     Boolean   @default(false) // required viewing for the linked class
  dueDate        DateTime? // optional deadline for required viewing
  uploadedById   String
  uploadedByName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progressRecords VideoProgress[]
  socialPosts     SocialPost[]

  @@index([classId])
  @@index([subjectId])
  @@index([uploadedById])
}

model VideoProgress {
  id      String      @id @default(uuid())
  userId  String
  videoId String
  video   VideoLesson @relation(fields: [videoId], references: [id], onDelete: Cascade)

  // Position in seconds where the user stopped watching
  currentPosition Int      @default(0)
  // Whether the user has completed the video (watched 90%+)
  isCompleted     Boolean  @default(false)
  // Last time this progress was updated
  lastWatchedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  userName    String?
  action      String
  entityType  String
  entityId    String?
  description String
  ipAddress   String?
  userAgent   String?
  severity    String   @default("INFO")
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
}

model Book {
  id              String  @id @default(uuid())
  title           String
  author          String?
  isbn            String?
  publisher       String?
  publishedYear   Int?
  category        String? // e.g. Fiction, Science, Reference
  language        String?
  edition         String?
  shelfLocation   String? // e.g. "A-12", "Reference Shelf 3"
  description     String?
  coverUrl        String?
  totalCopies     Int     @default(1)
  availableCopies Int     @default(1)

  loans BookLoan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([author])
  @@index([category])
  @@index([isbn])
}

model BookLoan {
  id     String @id @default(uuid())
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  studentId    String?
  borrowerName String
  borrowerType String? // e.g. STUDENT, TEACHER, STAFF, OTHER

  status       BookLoanStatus @default(BORROWED)
  borrowedDate DateTime       @default(now())
  dueDate      DateTime
  returnedDate DateTime?

  recordedById   String?
  recordedByName String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
  @@index([studentId])
  @@index([status])
}

model AdmissionApplication {
  id            String    @id @default(uuid())
  applicationNo String?   @unique
  applicantName String
  preferredName String?
  email         String?
  dateOfBirth   DateTime?
  gender        String?
  country       String?
  address       String?
  contactNumber String?

  targetLevel            String?
  targetClassId          String?
  previousSchool         String?
  previousEducationLevel String?
  previousEducationNotes String?

  guardianName                 String?
  guardianRelationship         String?
  guardianPhone                String?
  guardianEmail                String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  identityType             String?
  identityNumber           String?
  legalDocumentationStatus String? @default("PENDING") // PENDING | VERIFIED | MISSING | EXPIRED
  boardingType             String? @default("DAY") // DAY | BOARDING
  medicalInformation       String?
  allergies                String?
  medicationNotes          String?

  interviewAt       DateTime?
  interviewMode     String?
  interviewLocation String?
  interviewNotes    String?
  decisionAt        DateTime?
  decisionById      String?
  decisionByName    String?
  decisionNotes     String?
  status            String    @default("SUBMITTED") // SUBMITTED | DOCUMENTS_PENDING | INTERVIEW_SCHEDULED | UNDER_REVIEW | APPROVED | WAITLISTED | REJECTED | ENROLLED | WITHDRAWN
  priority          String?   @default("NORMAL") // LOW | NORMAL | HIGH
  notes             String?

  convertedStudentId String?
  convertedUserId    String?
  convertedAt        DateTime?
  submittedAt        DateTime  @default(now())
  createdById        String?
  createdByName      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  documents AdmissionDocument[]
  timeline  AdmissionTimelineEvent[]

  @@index([applicationNo])
  @@index([status])
  @@index([targetLevel])
  @@index([targetClassId])
  @@index([convertedStudentId])
}

model AdmissionDocument {
  id              String               @id @default(uuid())
  applicationId   String
  application     AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title           String
  documentType    String               @default("OTHER") // UNHCR | PASSPORT | BIRTH_CERTIFICATE | SCHOOL_RECORD | GUARDIAN_DOC | MEDICAL | PHOTO | OTHER
  checklistStatus String               @default("PENDING") // PENDING | RECEIVED | VERIFIED | REJECTED | NOT_REQUIRED
  fileUrl         String?
  fileName        String?
  fileSize        Int                  @default(0)
  mimeType        String               @default("application/octet-stream")
  notes           String?
  uploadedById    String?
  uploadedByName  String?
  verifiedById    String?
  verifiedByName  String?
  verifiedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([applicationId])
  @@index([documentType])
  @@index([checklistStatus])
}

model AdmissionTimelineEvent {
  id            String               @id @default(uuid())
  applicationId String
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  eventType     String
  title         String
  description   String?
  fromStatus    String?
  toStatus      String?
  createdById   String?
  createdByName String?
  createdAt     DateTime             @default(now())

  @@index([applicationId])
  @@index([eventType])
}

model AcademicCalendarEvent {
  id        String    @id @default(uuid())
  title     String
  eventType String    @default("SCHOOL") // SCHOOL | HOLIDAY | EXAM | MEETING | ACTIVITY
  startDate DateTime
  endDate   DateTime?
  audience  String    @default("ALL") // ALL | STUDENTS | TEACHERS | STAFF
  location  String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([startDate])
  @@index([eventType])
}

model Assignment {
  id            String    @id @default(uuid())
  title         String
  description   String?
  classId       String?
  subjectId     String?
  dueDate       DateTime?
  status        String    @default("OPEN") // OPEN | CLOSED | ARCHIVED
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([classId])
  @@index([subjectId])
  @@index([status])
}

model CertificateRecord {
  id              String   @id @default(uuid())
  studentId       String?
  studentName     String
  certificateType String
  issueDate       DateTime @default(now())
  status          String   @default("ISSUED") // DRAFT | ISSUED | REVOKED
  referenceNo     String?  @unique
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([studentId])
  @@index([status])
}

model CommunicationLog {
  id            String    @id @default(uuid())
  title         String
  channel       String    @default("PHONE") // PHONE | SMS | EMAIL | MEETING | HOME_VISIT | OTHER
  audience      String    @default("GUARDIAN") // GUARDIAN | STUDENT | TEACHER | STAFF | COMMUNITY
  contactName   String?
  contactInfo   String?
  message       String
  followUpDate  DateTime?
  status        String    @default("LOGGED") // LOGGED | NEEDS_FOLLOW_UP | RESOLVED
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([channel])
  @@index([status])
}

model InventoryItem {
  id         String   @id @default(uuid())
  name       String
  category   String   @default("GENERAL")
  quantity   Int      @default(1)
  condition  String   @default("GOOD") // NEW | GOOD | NEEDS_REPAIR | LOST | RETIRED
  location   String?
  assignedTo String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([condition])
}

model Ebook {
  id              String  @id @default(uuid())
  title           String
  // Normalized title (NFKC + trimmed + whitespace-collapsed + lowercased) used
  // for duplicate detection. Indexed so findDuplicateEbookTitle is a lookup,
  // not a full-table scan. Backfilled by migration; kept in sync on write.
  titleLower      String?
  author          String?
  description     String?
  category        String?
  seriesName      String?
  // Normalized series name, for the same reason as titleLower.
  seriesNameLower String?
  seriesNumber    Int?
  language        String?
  coverUrl        String?

  format       String // "PDF" | "EPUB" | "CBR" | "CBZ"
  fileName     String // stored file name on disk (uuid + ext)
  originalName String? // original upload filename
  fileSize     Int? // bytes

  visibility      String  @default("ALL") // ALL | STUDENTS | TEACHERS_ONLY
  downloadAllowed Boolean @default(false) // false = read online only

  uploadedById   String?
  uploadedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress   EbookProgress[]
  highlights EbookHighlight[]

  @@index([title])
  @@index([titleLower])
  @@index([author])
  @@index([category])
  @@index([seriesName, seriesNumber])
  @@index([seriesNameLower, seriesNumber])
  @@index([format])
}

// English -> Burmese dictionary. One row per (word, sense) pair, seeded once
// from prisma/seed-data/en-my-dictionary.json (see prisma/seedEnMyDictionary.ts
// for provenance/licensing notes on the source data). Static reference data,
// not user-generated, so there's no FK/ownership to worry about.
model EnMyDictionaryEntry {
  id         String  @id @default(uuid())
  word       String // original-case headword, e.g. "Dog"
  wordLower  String // normalized lookup key, e.g. "dog"
  pos        String? // part of speech / inflection tag, e.g. "n", "v[pt]"
  definition String // Burmese translation/gloss

  @@index([wordLower])
}

// Mon dictionary. Mon is headword-keyed (unlike EnMyDictionaryEntry above),
// with definitions in English, Burmese, and Thai attached per word -- mirrors
// the source project's own Word/Definition relational structure. Seeded once
// from prisma/seed-data/mon-dictionary.json via prisma/seedMonDictionary.ts.
// MIT-licensed source data (see README Acknowledgments), so no licensing
// caveat here unlike EnMyDictionaryEntry.
model MonWord {
  id          String          @id @default(uuid())
  word        String // Mon-script headword
  ipa         String? // IPA-ish romanized pronunciation
  thaiGloss   String? // short Thai gloss carried on the word itself in the source data
  definitions MonDefinition[]

  @@index([word])
}

// One row per (word, language, sense). lang is "eng" | "mya" | "tha".
model MonDefinition {
  id         String  @id @default(uuid())
  wordId     String
  lang       String
  pos        String?
  definition String
  example    String?

  word MonWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@index([lang])
}

// Chinese (Mandarin) dictionary, sourced from CC-CEDICT -- see
// prisma/seedChineseDictionary.ts for provenance and license notes
// (Creative Commons Attribution-ShareAlike). One row per CEDICT entry: a
// given simplified/traditional pair can have more than one row when CEDICT
// lists more than one pronunciation or sense for it, matching the source
// format. Populated separately by `npm run seed:chinese-dictionary`.
model ChineseDictionaryEntry {
  id          String   @id @default(uuid())
  simplified  String
  traditional String
  pinyin      String // numbered-tone pinyin exactly as published, e.g. "ni3 hao3"
  definitions String[] // one gloss per CEDICT "/"-separated slot

  @@index([simplified])
  @@index([traditional])
}

// Per-reader "resume where you left off" position. userId is a plain field
// rather than a User relation (Ebook itself follows the same loose-coupling
// convention already), so it's cleaned up manually on account deletion --
// see the three user-deletion transaction blocks in server.ts.
model EbookProgress {
  id                  String    @id @default(uuid())
  userId              String
  ebookId             String
  location            String // EPUB: rendition CFI. PDF: page number as a string.
  percent             Float? // 0-100 furthest point reached, not merely the current page.
  totalReadingSeconds Int       @default(0)
  openCount           Int       @default(1)
  firstOpenedAt       DateTime  @default(now())
  lastOpenedAt        DateTime  @default(now())
  completedAt         DateTime?
  updatedAt           DateTime  @updatedAt

  ebook Ebook @relation(fields: [ebookId], references: [id], onDelete: Cascade)

  @@unique([userId, ebookId])
  @@index([userId])
  @@index([ebookId])
  @@index([lastOpenedAt])
}

// A saved passage. EPUB highlights carry a range CFI so they can be
// re-rendered on the page; PDF "highlights" are lighter-weight (page + text
// only, no on-page overlay) since anchoring a selection back to exact PDF
// text-layer coordinates is out of scope for now.
model EbookHighlight {
  id        String   @id @default(uuid())
  userId    String
  userName  String?
  ebookId   String
  cfi       String? // EPUB range CFI (null for PDF)
  page      Int? // PDF page number (null for EPUB)
  text      String
  color     String   @default("yellow")
  createdAt DateTime @default(now())

  ebook Ebook @relation(fields: [ebookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ebookId])
}

model Announcement {
  id            String    @id @default(uuid())
  title         String
  body          String
  audience      String    @default("ALL") // ALL | TEACHERS | STUDENTS | CLASS
  classId       String?
  className     String?
  pinned        Boolean   @default(false)
  expiresAt     DateTime?
  createdById   String?
  createdByName String?
  status        String    @default("ACTIVE") // ACTIVE | ARCHIVED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([audience])
  @@index([status])
  @@index([classId])
}

model TimetableEntry {
  id                    String    @id @default(uuid())
  classId               String?
  className             String?
  subjectId             String?
  subjectName           String?
