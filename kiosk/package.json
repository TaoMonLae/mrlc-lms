{
  "name": "mrlc-lms-kiosk",
  "productName": "MRLC LMS Kiosk",
  "version": "0.2.0",
  "private": true,
  "author": "MRLC",
  "description": "Supervised desktop kiosk companion for MRLC-LMS",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "pilot:mac:arm64": "electron-builder --mac dmg --arm64 --publish never -c.mac.identity=null -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "pilot:mac:x64": "electron-builder --mac dmg --x64 --publish never -c.mac.identity=null -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "pilot:win:x64": "electron-builder --win nsis --x64 --publish never",
    "release:mac:arm64": "node release-preflight.cjs mac && electron-builder --mac dmg --arm64 --publish never -c.forceCodeSigning=true",
    "release:mac:x64": "node release-preflight.cjs mac && electron-builder --mac dmg --x64 --publish never -c.forceCodeSigning=true",
    "release:win:x64": "node release-preflight.cjs win && electron-builder --win nsis --x64 --publish never -c.forceCodeSigning=true"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.monrefugeelc.mrlckiosk",
    "productName": "MRLC LMS Kiosk",
    "asar": true,
    "directories": { "output": "release", "buildResources": "assets" },
    "files": ["main.cjs", "preload.cjs", "policy.cjs", "session-watcher.cjs", "offline.html", "config.json", "package.json"],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "notarize": true,
      "artifactName": "MRLC-LMS-Kiosk-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "artifactName": "MRLC-LMS-Kiosk-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": false
    }
  }
}
