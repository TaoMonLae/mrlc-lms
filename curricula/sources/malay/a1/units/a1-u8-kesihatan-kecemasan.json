  "scenario": {
    "id": "a1-u8-clinic-symptoms",
    "setting": "Describing symptoms at a government health clinic counter",
    "roles": ["learner (patient)", "clinic staff"],
    "script": [
      { "role": "staff", "ms": "Selamat pagi. Kenapa, ya?", "en": "Good morning. What's the matter?" },
      { "role": "learner", "ms": "Saya demam dah tiga hari, dan batuk.", "en": "I've had a fever for three days, and a cough." },
      { "role": "staff", "ms": "Ada alahan ubat tak?", "en": "Do you have any medicine allergies?" },
      { "role": "learner", "ms": "Tak ada.", "en": "No, I don't." },
      { "role": "staff", "ms": "Okay, ambil nombor giliran, tunggu sebentar. Nanti doktor panggil.", "en": "Okay, take a queue number, wait a moment. The doctor will call you." },
      { "role": "learner", "ms": "Baik, terima kasih.", "en": "Alright, thank you." }
    ],
    "aiPrompt": "You are clinic reception/nursing staff at a Malaysian government health clinic (klinik kesihatan). Ask what's wrong, ask about symptoms and allergies, then direct the patient to take a queue number and wait. Speak clearly, patiently, and use simple colloquial KL Malay."
  },
