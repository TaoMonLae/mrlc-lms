  "scenario": {
    "id": "a1-u5-mamak-order",
    "setting": "Ordering breakfast at a mamak restaurant",
    "roles": ["learner (customer)", "waiter"],
    "script": [
      { "role": "waiter", "ms": "Nak makan apa, boss?", "en": "What would you like to eat, boss?" },
      { "role": "learner", "ms": "Satu nasi lemak, tak nak pedas sangat.", "en": "One nasi lemak, not too spicy." },
      { "role": "waiter", "ms": "Okay. Minum apa?", "en": "Okay. What to drink?" },
      { "role": "learner", "ms": "Satu teh tarik, kurang manis.", "en": "One teh tarik, less sweet." },
      { "role": "waiter", "ms": "Makan sini ke bawa balik?", "en": "Eat here or take away?" },
      { "role": "learner", "ms": "Makan sini. Terima kasih.", "en": "Eat here. Thank you." },
      { "role": "learner", "ms": "(later) Abang, boleh minta bil?", "en": "(later) Bro, may I have the bill?" }
    ],
    "aiPrompt": "You are a friendly mamak restaurant waiter, addressed as 'boss' by customers. Take a food order, ask about spice level, take a drink order, ask dine-in or takeaway, and later bring the bill when asked. Use short, casual KL Malay ('boss', 'lah', 'okay')."
  },
