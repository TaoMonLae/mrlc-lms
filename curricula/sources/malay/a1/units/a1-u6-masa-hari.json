      { "role": "learner", "ms": "Okay. Saya ada temujanji pukul sepuluh, betul tak?", "en": "Okay. I have an appointment at ten, is that right?" },
      { "role": "receptionist", "ms": "Betul. Sila datang pukul sepuluh, jangan lambat.", "en": "Correct. Please come at ten, don't be late." },
      { "role": "learner", "ms": "Baik, nanti saya datang. Terima kasih.", "en": "Alright, I'll come later. Thank you." }
    ],
