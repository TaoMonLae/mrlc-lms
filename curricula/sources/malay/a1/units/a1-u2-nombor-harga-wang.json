  "scenario": {
    "id": "a1-u2-buying-phone-credit",
    "setting": "Buying prepaid phone credit (top-up) at a small shop",
    "roles": ["learner", "shopkeeper"],
    "script": [
      { "role": "learner", "ms": "Encik, ada topup Digi tak?", "en": "Sir, do you have Digi top-up?" },
      { "role": "shopkeeper", "ms": "Ada. Nak berapa ringgit?", "en": "We have it. How many ringgit do you want?" },
      { "role": "learner", "ms": "Tiga puluh ringgit.", "en": "Thirty ringgit." },
      { "role": "shopkeeper", "ms": "Okay, tiga puluh ringgit. Nombor telefon awak?", "en": "Okay, thirty ringgit. Your phone number?" },
      { "role": "learner", "ms": "Ini nombor saya.", "en": "This is my number." },
      { "role": "shopkeeper", "ms": "Siap. Bayar cash ke kad?", "en": "Done. Pay cash or card?" },
      { "role": "learner", "ms": "Cash. Ini lima puluh ringgit.", "en": "Cash. Here's fifty ringgit." },
      { "role": "shopkeeper", "ms": "Baik. Ini baki awak, dua puluh ringgit.", "en": "Alright. Here's your change, twenty ringgit." }
    ],
    "aiPrompt": "You are a Malaysian mobile phone shop clerk. The learner wants to top up prepaid credit. Ask which telco and how much, ask for their phone number, confirm the amount, ask cash or card, and give change correctly if they overpay. Keep sentences short and speak at a natural but unhurried pace."
  },
