  "scenario": {
    "id": "a1-u3-school-registration",
    "setting": "A parent registering their child at a community/refugee learning centre reception desk",
    "roles": ["learner (parent)", "receptionist"],
    "script": [
      { "role": "receptionist", "ms": "Selamat pagi. Nak daftarkan anak, ya?", "en": "Good morning. Registering a child, right?" },
      { "role": "learner", "ms": "Ya, betul. Ini anak saya.", "en": "Yes, correct. This is my child." },
      { "role": "receptionist", "ms": "Anak awak umur berapa?", "en": "How old is your child?" },
      { "role": "learner", "ms": "Umur dia sepuluh tahun.", "en": "He/she is ten years old." },
      { "role": "receptionist", "ms": "Okay. Awak kerja apa sekarang?", "en": "Okay. What do you do for work now?" },
      { "role": "learner", "ms": "Saya kerja kat kedai makan.", "en": "I work at a food stall." },
      { "role": "receptionist", "ms": "Baik, terima kasih. Kami hubungi awak nanti.", "en": "Alright, thank you. We'll contact you later." }
    ],
    "aiPrompt": "You are a receptionist at a community learning centre registering a refugee parent's child. Ask the child's age, the parent's occupation, and where they live. Be warm, patient, and speak in short, simple colloquial KL Malay sentences."
  },
