  "scenario": {
    "id": "a1-u7-asking-lrt-directions",
    "setting": "Asking a stranger for directions to the nearest LRT station",
    "roles": ["learner", "passerby"],
    "script": [
      { "role": "learner", "ms": "Maaf, stesen LRT kat mana, ya?", "en": "Excuse me, where is the LRT station?" },
      { "role": "passerby", "ms": "Oh, jalan terus, lepas tu pusing kanan.", "en": "Oh, go straight, then turn right after that." },
      { "role": "learner", "ms": "Jauh tak dari sini?", "en": "Is it far from here?" },
      { "role": "passerby", "ms": "Tak jauh, lima minit jalan kaki je.", "en": "Not far, just a five-minute walk." },
      { "role": "learner", "ms": "Okay, terima kasih banyak-banyak!", "en": "Okay, thank you very much!" }
    ],
    "aiPrompt": "You are a helpful Malaysian passerby giving simple walking directions to the nearest LRT station. Use short direction phrases (jalan terus, pusing kiri/kanan) and give a rough walking time. Speak slowly and clearly."
  },
