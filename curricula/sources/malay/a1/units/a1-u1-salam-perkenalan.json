  "scenario": {
    "id": "a1-u1-first-day-neighbour",
    "setting": "Meeting a new neighbour outside your apartment block for the first time",
    "roles": ["learner", "neighbour"],
    "script": [
      { "role": "neighbour", "ms": "Selamat pagi! Saya belum kenal awak. Nama saya Kak Zaidah.", "en": "Good morning! I haven't met you. My name is Kak Zaidah." },
      { "role": "learner", "ms": "Selamat pagi, kak. Nama saya Tao. Saya dari Myanmar.", "en": "Good morning. My name is Tao. I'm from Myanmar." },
      { "role": "neighbour", "ms": "Oh, baguslah! Awak tinggal blok mana?", "en": "Oh, nice! Which block do you live in?" },
      { "role": "learner", "ms": "Saya tinggal blok B, tingkat tiga.", "en": "I live in block B, third floor." },
      { "role": "neighbour", "ms": "Okay. Jumpa lagi, ya!", "en": "Okay. See you again!" },
      { "role": "learner", "ms": "Jumpa lagi. Terima kasih, kak!", "en": "See you again. Thank you!" }
    ],
    "aiPrompt": "You are Kak Zaidah, a friendly middle-aged Malaysian neighbour meeting the learner for the first time outside an apartment block. Greet them warmly, ask their name and where they're from, ask a simple follow-up question (which block/floor they live in), and close warmly. Speak slowly, use short colloquial KL Malay sentences (max 8 words), and gently correct the learner only once if they make a greeting mistake."
  },
  "speakingPrompts": [
    { "id": "a1-u1-shadow-1", "type": "shadowing", "instructions": "Listen to the full neighbour dialogue and shadow each line, matching the rhythm and the soft final schwa on 'saya' and 'nama'.", "targetAudioUrl": "/audio/ms/a1-u1-scenario.mp3", "rubric": ["schwa on final -a in 'saya'/'nama'", "rising intonation on 'apa khabar?'", "natural pace, no word-by-word reading"] },
    { "id": "a1-u1-roleplay-1", "type": "roleplay", "instructions": "Play the learner role opposite the AI 'Kak Zaidah' persona. Introduce yourself, say where you're from, and answer her follow-up question.", "targetAudioUrl": null, "rubric": ["correct greeting for time of day", "clear self-introduction", "appropriate form of address"] },
    { "id": "a1-u1-pron-1", "type": "pronunciation", "instructions": "Record yourself saying 'khabar baik' and 'nak balik'. Check that you can hear the difference between the two.", "targetAudioUrl": "/audio/ms/v-khabar-baik.mp3", "rubric": ["distinguishes 'baik' /ba-ik/ from 'balik' /ba-lik/"] }
