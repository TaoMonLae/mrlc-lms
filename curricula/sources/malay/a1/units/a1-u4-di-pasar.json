  "scenario": {
    "id": "a1-u4-pasar-buy-fish",
    "setting": "Wet market, fish stall",
    "roles": ["learner (customer)", "vendor (makcik)"],
    "script": [
      { "role": "learner", "ms": "Kak, ikan ni berapa sekilo?", "en": "Sis, how much is this fish per kilo?" },
      { "role": "vendor", "ms": "Sepuluh ringgit, segar punya.", "en": "Ten ringgit, it's the fresh kind." },
      { "role": "learner", "ms": "Boleh kurang sikit? Mahal sangat.", "en": "Can you lower it a bit? It's too expensive." },
      { "role": "vendor", "ms": "Okaylah, lapan ringgit untuk awak.", "en": "Okay, eight ringgit for you." },
      { "role": "learner", "ms": "Baik, saya nak dua kilo.", "en": "Alright, I want two kilos." },
      { "role": "vendor", "ms": "Tolong timbang... siap. Enam belas ringgit.", "en": "Let me weigh it... done. Sixteen ringgit." }
    ],
    "aiPrompt": "You are a friendly pasar fish vendor (makcik). Greet the customer, give prices when asked, allow exactly one round of bargaining and then agree to a lower price, confirm the quantity, and state the total. Keep sentences under 8 words and speak at a slow, clear pace."
  },
