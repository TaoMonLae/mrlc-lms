  "scenario": {
    "id": "c1-u5-pitching-a-proposal",
    "setting": "Pitching a business proposal to a senior manager and receiving pushback",
    "roles": [
      "learner",
      "senior manager"
    ],
    "script": [
      {
        "role": "learner",
        "ms": "Ini cadangan perniagaan saya untuk memperluas perkhidmatan.",
        "en": "This is my business proposal to expand the service."
      },
      {
        "role": "manager",
        "ms": "Apa justifikasi untuk kos tambahan ini?",
        "en": "What's the justification for this additional cost?"
      },
      {
        "role": "learner",
        "ms": "Data pasaran mengukuhkan hujah bahawa permintaan akan meningkat.",
        "en": "Market data strengthens the argument that demand will increase."
      },
      {
        "role": "manager",
        "ms": "Selanjutnya, macam mana kita meminimumkan risiko kewangan?",
        "en": "Furthermore, how do we minimise financial risk?"
      },
      {
        "role": "learner",
        "ms": "Kami cadangkan fasa percubaan kecil dulu sebelum pelaburan penuh.",
        "en": "We propose a small pilot phase first before full investment."
      }
    ],
    "aiPrompt": "You are a senior manager reviewing a business proposal, asking probing questions about justification and risk. Push back constructively, then respond positively to a well-reasoned answer. Formal, high-register business Malay."
  },
  "speakingPrompts": [
    {
