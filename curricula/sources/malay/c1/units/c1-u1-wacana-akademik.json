  "scenario": {
    "id": "c1-u1-academic-seminar-discussion",
    "setting": "Discussing a research topic at a university seminar",
    "roles": [
      "learner",
      "academic peer"
    ],
    "script": [
      {
        "role": "peer",
        "ms": "Kajian menunjukkan bahawa migrasi mempengaruhi struktur keluarga.",
        "en": "Studies show that migration affects family structure."
      },
      {
        "role": "learner",
        "ms": "Menarik. Apa kerangka konseptual yang digunakan?",
        "en": "Interesting. What conceptual framework was used?"
      },
      {
        "role": "peer",
        "ms": "Kami memetik teori integrasi sosial sebagai asas.",
        "en": "We cite social integration theory as the basis."
      },
      {
        "role": "learner",
        "ms": "Lanjutan daripada itu, apa implikasi dasar yang dicadangkan?",
        "en": "Building on that, what policy implications are proposed?"
      },
      {
        "role": "peer",
        "ms": "Secara tersirat, kajian ini mencadangkan sokongan komuniti diperkukuh.",
        "en": "Implicitly, this study suggests community support should be strengthened."
      }
    ],
    "aiPrompt": "You are an academic peer discussing a research finding on migration at a seminar. Use precise academic register (kajian, hipotesis, kerangka konseptual, implikasi) and engage thoughtfully with follow-up questions."
  },
  "speakingPrompts": [
    {
      "id": "c1-u1-shadow-1",
