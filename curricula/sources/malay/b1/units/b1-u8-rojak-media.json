  "vocab": [
    {
      "id": "b1-mcm",
      "type": "vocab",
      "ms": "mcm / cmni / cmtu",
      "en": "like / like this / like that (texting shorthand for 'macam', 'macam ni', 'macam tu')",
      "mon": null,
      "register": "rojak",
      "example": "Jangan buat mcm tu lah.",
      "exampleEn": "Don't do it like that.",
      "phonetic": "muh-cham",
