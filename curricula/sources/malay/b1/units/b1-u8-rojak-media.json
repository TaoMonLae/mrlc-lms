      "minimalPairWith": null
    },
    {
      "id": "b1-xde",
      "type": "vocab",
      "ms": "xde / xleh / xpe",
      "en": "texting shorthand for 'tak ada' (none), 'tak boleh' (can't), 'tak apa' (never mind)",
      "mon": null,
      "register": "rojak",
      "example": "Xde masalah, xpe.",
      "exampleEn": "No problem, never mind.",
