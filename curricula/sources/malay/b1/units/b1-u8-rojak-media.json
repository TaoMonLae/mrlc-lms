  "scenario": {
    "id": "b1-u8-whatsapp-group-chat",
    "setting": "Reading and replying to a fast-moving WhatsApp group chat among friends",
    "roles": [
      "learner",
      "friend group (multiple voices)"
    ],
    "script": [
      {
        "role": "friend1",
        "ms": "Weh, korang tengok video tu tak? Power gila!",
        "en": "Hey, did you all see that video? So awesome!"
      },
      {
        "role": "friend2",
        "ms": "Confirm dah viral kat TikTok tu.",
        "en": "It's definitely gone viral on TikTok."
      },
      {
        "role": "learner",
        "ms": "Belum tengok lagi, link mana?",
        "en": "Haven't watched it yet, where's the link?"
      },
      {
        "role": "friend1",
        "ms": "Nanti saya share. Btw, korang free petang ni?",
        "en": "I'll share it later. By the way, are you all free this evening?"
      },
      {
        "role": "learner",
        "ms": "Santai je, saya free.",
        "en": "Sure, I'm free."
      }
    ],
    "aiPrompt": "You are simulating a fast, casual Malaysian friend group chat with heavy Manglish/Bahasa Rojak (power, confirm, viral, btw, santai). Keep messages short like real texts. Occasionally ask the learner a direct question to keep them engaged."
  },
