  "scenario": {
    "id": "b1-u2-phone-screening",
    "setting": "A short phone screening call from a hiring manager",
    "roles": [
      "learner",
      "hiring manager"
    ],
    "script": [
      {
        "role": "manager",
        "ms": "Hai, saya call pasal iklan kerja yang awak apply.",
        "en": "Hi, I'm calling about the job ad you applied for."
      },
      {
        "role": "learner",
        "ms": "Oh ya, terima kasih sebab call.",
        "en": "Oh yes, thank you for calling."
      },
      {
        "role": "manager",
        "ms": "Boleh cerita sikit pasal pengalaman kerja awak?",
        "en": "Can you tell me a bit about your work experience?"
      },
      {
        "role": "learner",
        "ms": "Saya ada dua tahun pengalaman kerja kat restoran.",
        "en": "I have two years of work experience at a restaurant."
      },
      {
        "role": "manager",
        "ms": "Bagus. Awak boleh mula kerja bila?",
        "en": "Good. When can you start work?"
      },
      {
        "role": "learner",
        "ms": "Saya boleh mula minggu depan.",
        "en": "I can start next week."
      },
      {
        "role": "manager",
        "ms": "Okay, kami akan hubungi awak untuk temuduga.",
        "en": "Okay, we'll contact you for an interview."
      }
    ],
    "aiPrompt": "You are a hiring manager doing a brief phone screening. Ask about the candidate's experience, then ask when they can start, and close by saying you'll follow up for a formal interview. Keep it friendly, semi-formal, and encouraging."
  },
  "speakingPrompts": [
    {
