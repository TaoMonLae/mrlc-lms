  "scenario": {
    "id": "b1-u9-negotiating-repair-cost",
    "setting": "Negotiating who pays for a repair cost with a landlord",
    "roles": [
      "learner",
      "landlord"
    ],
    "script": [
      {
        "role": "landlord",
        "ms": "Kerosakan tu awak yang kena bayar.",
        "en": "You're the one who needs to pay for that damage."
      },
      {
        "role": "learner",
        "ms": "Saya rasa ni tak adil, sebab kerosakan tu bukan salah saya.",
        "en": "I think this is unfair, because the damage wasn't my fault."
      },
      {
        "role": "landlord",
        "ms": "Habis tu, siapa nak bayar?",
        "en": "So then, who's going to pay?"
      },
      {
        "role": "learner",
        "ms": "Mungkin kita boleh cari jalan tengah, bahagi kos.",
        "en": "Maybe we can find a middle ground, split the cost."
      },
      {
        "role": "landlord",
        "ms": "Biar saya fikir dulu... okay, boleh, kita bahagi separuh-separuh.",
        "en": "Let me think about it... okay, alright, we'll split it fifty-fifty."
      },
      {
        "role": "learner",
        "ms": "Baik, saya setuju dengan tu.",
        "en": "Alright, I agree with that."
      }
    ],
    "aiPrompt": "You are a landlord who initially insists the tenant pays for a repair. Push back once, then be open to a compromise (splitting the cost) when the tenant proposes it reasonably. Stay firm but fair, not hostile."
  },
