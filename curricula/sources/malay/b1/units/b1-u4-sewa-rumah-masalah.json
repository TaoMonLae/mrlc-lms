  "scenario": {
    "id": "b1-u4-deposit-dispute",
    "setting": "Negotiating the return of a rental deposit after moving out",
    "roles": [
      "learner",
      "landlord"
    ],
    "script": [
      {
        "role": "learner",
        "ms": "Encik, saya dah keluar rumah. Bila deposit saya dipulangkan?",
        "en": "Sir, I've moved out. When will my deposit be returned?"
      },
      {
        "role": "landlord",
        "ms": "Ada kerosakan kat dinding, jadi saya potong sikit.",
        "en": "There's damage on the wall, so I'll deduct a bit."
      },
      {
        "role": "learner",
        "ms": "Kerosakan tu dah ada sebelum saya masuk, encik.",
        "en": "That damage was already there before I moved in, sir."
      },
      {
        "role": "landlord",
        "ms": "Betul ke? Biar saya check gambar dulu.",
        "en": "Really? Let me check the photos first."
      },
      {
        "role": "learner",
        "ms": "Baik, saya ada gambar juga sebagai bukti.",
        "en": "Alright, I have photos too as proof."
      },
      {
        "role": "landlord",
        "ms": "Okay, kalau betul, saya pulangkan deposit penuh.",
        "en": "Okay, if that's true, I'll return the full deposit."
      }
    ],
    "aiPrompt": "You are a landlord disputing a damage deduction from a tenant's deposit. Initially push back, then soften when the tenant provides evidence (photos), and agree to a fair resolution. Stay reasonable, not hostile."
  },
