  "scenario": {
    "id": "b1-u6-overdue-bill-call",
    "setting": "Calling a utility company about an overdue bill and asking for an instalment plan",
    "roles": [
      "learner",
      "customer service agent"
    ],
    "script": [
      {
        "role": "learner",
        "ms": "Hai, saya nak tanya pasal bil tertunggak saya.",
        "en": "Hi, I want to ask about my overdue bill."
      },
      {
        "role": "agent",
        "ms": "Baik, boleh bagi nombor akaun awak?",
        "en": "Alright, may I have your account number?"
      },
      {
        "role": "learner",
        "ms": "Ini nombor akaun saya. Boleh bayar secara ansuran tak?",
        "en": "Here's my account number. Can I pay in instalments?"
      },
      {
        "role": "agent",
        "ms": "Boleh. Kami boleh bahagikan kepada tiga bayaran bulanan.",
        "en": "Yes. We can split it into three monthly payments."
      },
      {
        "role": "learner",
        "ms": "Baik, terima kasih banyak.",
        "en": "Alright, thank you very much."
      }
    ],
    "aiPrompt": "You are a utility company customer service agent handling a call about an overdue bill. Ask for the account number, then offer an instalment plan when asked. Be professional, patient, and clear."
  },
