  "scenario": {
    "id": "b1-u3-workplace-disagreement",
    "setting": "Resolving a misunderstanding with a colleague about a shared task",
    "roles": [
      "learner",
      "colleague"
    ],
    "script": [
      {
        "role": "colleague",
        "ms": "Eh, kenapa tugasan ni tak siap lagi?",
        "en": "Hey, why isn't this task finished yet?"
      },
      {
        "role": "learner",
        "ms": "Saya ingat awak yang buat bahagian ni.",
        "en": "I thought you were doing this part."
      },
      {
        "role": "colleague",
        "ms": "Oh, mungkin ada salah faham. Jom kita berbincang.",
        "en": "Oh, maybe there's a misunderstanding. Let's discuss it."
      },
      {
        "role": "learner",
        "ms": "Baik, saya rasa kita perlu bahagikan tugas dengan jelas lain kali.",
        "en": "Alright, I think we need to divide tasks clearly next time."
      },
      {
        "role": "colleague",
        "ms": "Setuju. Kerjasama penting.",
        "en": "Agreed. Cooperation is important."
      }
    ],
    "aiPrompt": "You are a colleague who discovers a shared task wasn't completed due to a misunderstanding. Express mild concern, then work collaboratively toward resolving it and agreeing on a clearer process next time. Keep tone calm and non-confrontational."
  },
