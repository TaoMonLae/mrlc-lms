  "scenario": {
    "id": "b1-u5-parent-teacher-meeting",
    "setting": "A parent-teacher meeting discussing a child's progress and a classroom incident",
    "roles": [
      "learner (parent)",
      "teacher"
    ],
    "script": [
      {
        "role": "teacher",
        "ms": "Terima kasih sebab datang. Perkembangan anak awak bagus dalam Matematik.",
        "en": "Thank you for coming. Your child's progress in Maths is good."
      },
      {
        "role": "learner",
        "ms": "Baguslah. Ada masalah lain tak?",
        "en": "That's good. Any other issues?"
      },
      {
        "role": "teacher",
        "ms": "Ada sikit. Dia bergaduh dengan kawan sekelas semalam.",
        "en": "A little. He/she had a fight with a classmate yesterday."
      },
      {
        "role": "learner",
        "ms": "Oh, saya akan cakap dengan dia di rumah.",
        "en": "Oh, I'll talk to him/her at home."
      },
      {
        "role": "teacher",
        "ms": "Bagus. Kerja rumah dia pun kadang-kadang lewat.",
        "en": "Good. His/her homework is also sometimes late."
      },
      {
        "role": "learner",
        "ms": "Baik, saya akan pantau lebih kerap.",
        "en": "Alright, I'll monitor it more closely."
      }
    ],
    "aiPrompt": "You are a class teacher meeting a parent. Give a balanced update: one positive point about academic progress, and one concern (a minor behavioural incident or late homework). Stay warm and constructive, standard-colloquial mix."
  },
