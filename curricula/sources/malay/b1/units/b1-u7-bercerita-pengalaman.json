  "scenario": {
    "id": "b1-u7-sharing-migration-story",
    "setting": "Sharing your migration story with a supportive new friend",
    "roles": [
      "learner",
      "friend"
    ],
    "script": [
      {
        "role": "friend",
        "ms": "Kalau tak kisah saya tanya, kenapa awak berhijrah ke Malaysia?",
        "en": "If you don't mind me asking, why did you migrate to Malaysia?"
      },
      {
        "role": "learner",
        "ms": "Saya berhijrah kerana keselamatan keluarga saya.",
        "en": "I migrated because of my family's safety."
      },
      {
        "role": "friend",
        "ms": "Mesti susah kan, waktu tu?",
        "en": "It must have been hard, at that time?"
      },
      {
        "role": "learner",
        "ms": "Ya, walaupun susah, akhirnya kami berjaya settle di sini.",
        "en": "Yes, although it was hard, we finally managed to settle here."
      },
      {
        "role": "friend",
        "ms": "Sekarang macam mana rasanya?",
        "en": "How does it feel now?"
      },
      {
        "role": "learner",
        "ms": "Sekarang lebih senang. Perasaan saya lebih tenang.",
        "en": "Now it's easier. I feel calmer."
      }
    ],
    "aiPrompt": "You are a warm, curious friend asking sensitively about the learner's migration experience. Ask open, respectful questions, react with empathy, and never pry into details they don't offer. Encourage them to share as much or as little as they want."
  },
