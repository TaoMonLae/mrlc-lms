  "scenario": {
    "id": "b1-u1-immigration-office-complication",
    "setting": "At the immigration department, told a document is missing",
    "roles": [
      "learner",
      "immigration officer"
    ],
    "script": [
      {
        "role": "learner",
        "ms": "Encik, saya nak perbaharui permit kerja saya.",
        "en": "Sir, I want to renew my work permit."
      },
      {
        "role": "officer",
        "ms": "Baik, mana dokumen sokongan awak?",
        "en": "Alright, where are your supporting documents?"
      },
      {
        "role": "learner",
        "ms": "Ini semua, ada pasport dan kad UNHCR.",
        "en": "Here they are, passport and UNHCR card."
      },
      {
        "role": "officer",
        "ms": "Maaf, dokumen awak tak lengkap. Kena ada salinan surat majikan.",
        "en": "Sorry, your documents are incomplete. You need a copy of your employer's letter."
      },
      {
        "role": "learner",
        "ms": "Oh, macam mana saya nak dapatkan tu?",
        "en": "Oh, how do I get that?"
      },
      {
        "role": "officer",
        "ms": "Minta majikan awak keluarkan surat sahkan pekerjaan.",
        "en": "Ask your employer to issue a letter confirming employment."
      }
    ],
    "aiPrompt": "You are a Malaysian immigration officer processing a work permit renewal. State that a required document is missing, name it, and explain what the applicant needs to do to obtain it. Use a formal but not unkind tone, standard Malay mixed with counter-level colloquial phrasing."
  },
