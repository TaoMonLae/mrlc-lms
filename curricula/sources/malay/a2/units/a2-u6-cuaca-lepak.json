  "scenario": {
    "id": "a2-u6-making-weekend-plans",
    "setting": "Making casual weekend plans with a friend",
    "roles": [
      "learner",
      "friend"
    ],
    "script": [
      {
        "role": "friend",
        "ms": "Hujung minggu ni awak free tak?",
        "en": "Are you free this weekend?"
      },
      {
        "role": "learner",
        "ms": "Free lah. Kenapa?",
        "en": "Yeah, free. Why?"
      },
      {
        "role": "friend",
        "ms": "Jom lepak, tengok wayang ke?",
        "en": "Let's hang out, maybe watch a movie?"
      },
      {
        "role": "learner",
        "ms": "Boleh! Tapi kalau hujan macam mana?",
        "en": "Sure! But what if it rains?"
      },
      {
        "role": "friend",
        "ms": "Takpe, kita pergi mall je, ada aircond.",
        "en": "It's fine, we'll just go to the mall, it has air-con."
      }
    ],
    "aiPrompt": "You are a casual Malaysian friend making weekend plans. Suggest an activity, respond to weather concerns, and keep the tone light and informal, using 'lah', 'jom', 'takpe'."
  },
