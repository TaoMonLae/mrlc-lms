  "scenario": {
    "id": "a2-u2-grab-pickup-confusion",
    "setting": "Coordinating with a Grab driver who can't find the pickup point",
    "roles": [
      "learner",
      "Grab driver (via call)"
    ],
    "script": [
      {
        "role": "driver",
        "ms": "Hello, saya dah sampai, tapi tak nampak awak.",
        "en": "Hello, I've arrived, but I don't see you."
      },
      {
        "role": "learner",
        "ms": "Saya kat depan pintu utama mall.",
        "en": "I'm in front of the mall's main entrance."
      },
      {
        "role": "driver",
        "ms": "Oh, saya kat belakang. Tunggu sekejap, saya pusing.",
        "en": "Oh, I'm at the back. Wait a moment, I'll turn around."
      },
      {
        "role": "learner",
        "ms": "Okay, plat nombor apa kereta awak?",
        "en": "Okay, what's your car's license plate number?"
      },
      {
        "role": "driver",
        "ms": "WXY 1234, kereta warna putih.",
        "en": "WXY 1234, white car."
      }
    ],
    "aiPrompt": "You are a Grab driver on a phone call, having trouble locating the passenger. Clarify your location, ask theirs, and give your car's plate number and colour. Speak naturally but clearly, KL colloquial style."
  },
