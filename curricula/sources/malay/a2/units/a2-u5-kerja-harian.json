  "scenario": {
    "id": "a2-u5-asking-for-leave",
    "setting": "Asking a supervisor for a day off",
    "roles": [
      "learner",
      "supervisor"
    ],
    "script": [
      {
        "role": "learner",
        "ms": "Bos, boleh saya ambil cuti hari Jumaat?",
        "en": "Boss, may I take leave on Friday?"
      },
      {
        "role": "supervisor",
        "ms": "Kenapa? Ada hal penting ke?",
        "en": "Why? Is it something important?"
      },
      {
        "role": "learner",
        "ms": "Ya, saya ada temujanji klinik untuk anak saya.",
        "en": "Yes, I have a clinic appointment for my child."
      },
      {
        "role": "supervisor",
        "ms": "Okay, boleh. Tapi bagitahu penyelia shif awal.",
        "en": "Okay, that's fine. But let your shift supervisor know early."
      },
      {
        "role": "learner",
        "ms": "Baik, terima kasih, bos.",
        "en": "Alright, thank you, boss."
      }
    ],
    "aiPrompt": "You are a workplace supervisor. The employee asks for a day off; ask the reason, then approve with a simple condition (informing the shift supervisor). Speak naturally, informally, as a Malaysian boss would to staff."
  },
