  "scenario": {
    "id": "a2-u8-casual-friend-chat",
    "setting": "A relaxed chat full of Malaysian slang between friends at a mamak",
    "roles": [
      "learner",
      "friend"
    ],
    "script": [
      {
        "role": "friend",
        "ms": "Weh, lapar tak? Jom makan sini lah.",
        "en": "Hey, hungry? Let's eat here."
      },
      {
        "role": "learner",
        "ms": "Boleh je. Sedap ke makanan sini?",
        "en": "Sure. Is the food here good?"
      },
      {
        "role": "friend",
        "ms": "Syok gila! Confirm awak suka punya.",
        "en": "So good! I'm sure you'll like it."
      },
      {
        "role": "learner",
        "ms": "Okay lah, jom!",
        "en": "Okay then, let's go!"
      },
      {
        "role": "friend",
        "ms": "Eh, jangan lupa bayar, jangan kantoi macam last time!",
        "en": "Hey, don't forget to pay, don't get caught out like last time!"
      }
    ],
    "aiPrompt": "You are a close Malaysian friend speaking very casually with heavy slang (lah, weh, gila, confirm, kantoi). Keep the banter light and friendly. If the learner uses a slang word correctly, react positively."
  },
