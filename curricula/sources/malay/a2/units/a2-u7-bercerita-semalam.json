  "scenario": {
    "id": "a2-u7-telling-friend-what-happened",
    "setting": "Telling a friend about a mishap on the way to work yesterday",
    "roles": [
      "learner",
      "friend"
    ],
    "script": [
      {
        "role": "friend",
        "ms": "Apa jadi semalam? Awak nampak penat.",
        "en": "What happened yesterday? You look tired."
      },
      {
        "role": "learner",
        "ms": "Semalam bas saya lewat, lepas tu saya lambat sampai kerja.",
        "en": "Yesterday my bus was late, after that I arrived late for work."
      },
      {
        "role": "friend",
        "ms": "Alamak. Bos marah tak?",
        "en": "Oh no. Was the boss angry?"
      },
      {
        "role": "learner",
        "ms": "Sikit je. Akhirnya semua okay.",
        "en": "Just a little. In the end everything was okay."
      }
    ],
    "aiPrompt": "You are a friend asking what happened yesterday. React naturally to the story with short interjections ('alamak', 'oh ye ke') and one follow-up question. Keep it casual and warm."
  },
