  "scenario": {
    "id": "a2-u4-report-leak-to-landlord",
    "setting": "Reporting a water leak to the landlord by phone",
    "roles": [
      "learner",
      "landlord"
    ],
    "script": [
      {
        "role": "learner",
        "ms": "Encik, maaf ganggu. Ada air bocor dekat siling bilik saya.",
        "en": "Sir, sorry to bother you. There's a water leak near my room's ceiling."
      },
      {
        "role": "landlord",
        "ms": "Oh, sejak bila?",
        "en": "Oh, since when?"
      },
      {
        "role": "learner",
        "ms": "Sejak semalam petang.",
        "en": "Since yesterday evening."
      },
      {
        "role": "landlord",
        "ms": "Baik, saya hantar tukang paip esok pagi.",
        "en": "Alright, I'll send a plumber tomorrow morning."
      },
      {
        "role": "learner",
        "ms": "Terima kasih, encik.",
        "en": "Thank you, sir."
      }
    ],
    "aiPrompt": "You are a landlord receiving a phone call about a household problem (a leak). Ask when it started and reassure the tenant you'll send help. Keep it polite and matter-of-fact, colloquial KL Malay."
  },
  "speakingPrompts": [
