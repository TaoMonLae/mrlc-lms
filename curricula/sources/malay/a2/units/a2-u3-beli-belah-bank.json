  "scenario": {
    "id": "a2-u3-bank-account-opening",
    "setting": "Opening a savings account at a bank branch",
    "roles": [
      "learner",
      "bank officer"
    ],
    "script": [
      {
        "role": "learner",
        "ms": "Selamat pagi, saya nak buka akaun bank.",
        "en": "Good morning, I want to open a bank account."
      },
      {
        "role": "officer",
        "ms": "Baik. Ada bawa pasport dan kad UNHCR?",
        "en": "Alright. Did you bring your passport and UNHCR card?"
      },
      {
        "role": "learner",
        "ms": "Ada, ini semua dokumen saya.",
        "en": "Yes, here are all my documents."
      },
      {
        "role": "officer",
        "ms": "Okay, ada caj bulanan lima ringgit untuk akaun ni.",
        "en": "Okay, there's a five-ringgit monthly fee for this account."
      },
      {
        "role": "learner",
        "ms": "Baik, tak masalah. Bila saya boleh dapat kad ATM?",
        "en": "Alright, no problem. When can I get the ATM card?"
      },
      {
        "role": "officer",
        "ms": "Dalam tujuh hari bekerja.",
        "en": "Within seven working days."
      }
    ],
    "aiPrompt": "You are a Malaysian bank officer helping a customer open a savings account. Ask for required documents, mention any monthly fee, and give a timeline for the ATM card. Speak in clear, semi-formal Malay (a mix of standard and colloquial, as used at bank counters)."
  },
