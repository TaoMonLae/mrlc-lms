  "scenario": {
    "id": "b2-u1-team-meeting-disagreement",
    "setting": "Chairing a team meeting where you disagree with a colleague's proposal",
    "roles": [
      "learner (chair)",
      "colleague"
    ],
    "script": [
      {
        "role": "learner",
        "ms": "Baik, mari kita mula dengan agenda pertama — jadual projek.",
        "en": "Alright, let's start with the first agenda item — the project schedule."
      },
      {
        "role": "colleague",
        "ms": "Pada pandangan saya, kita patut lambatkan pelancaran dua minggu.",
        "en": "In my view, we should delay the launch by two weeks."
      },
      {
        "role": "learner",
        "ms": "Saya faham pandangan awak, tapi sebaliknya, saya rasa kita boleh capai tarikh asal.",
        "en": "I understand your view, but on the contrary, I think we can meet the original date."
      },
      {
        "role": "colleague",
        "ms": "Boleh saya kemukakan cadangan alternatif — kita tambah satu lagi ahli pasukan?",
        "en": "May I propose an alternative — we add one more team member?"
      },
      {
        "role": "learner",
        "ms": "Idea yang baik. Oleh itu, mari kita rumuskan: tambah ahli pasukan, kekalkan tarikh asal.",
        "en": "Good idea. Therefore, let's summarise: add a team member, keep the original date."
      }
    ],
    "aiPrompt": "You are a colleague proposing a schedule delay in a work meeting, then offering a constructive alternative when challenged. Use polite disagreement markers (pada pandangan saya, sebaliknya) and standard-register workplace Malay."
  },
