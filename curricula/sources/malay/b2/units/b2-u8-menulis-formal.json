  "scenario": {
    "id": "b2-u8-drafting-complaint-letter",
    "setting": "Drafting a formal written complaint letter with AI writing-coach feedback",
    "roles": [
      "learner",
      "AI writing coach"
    ],
    "script": [
      {
        "role": "learner",
        "ms": "Boleh bantu saya tulis surat aduan rasmi?",
        "en": "Can you help me write a formal complaint letter?"
      },
      {
        "role": "coach",
        "ms": "Boleh. Mula dengan 'Tuan/Puan,' dan nyatakan tujuan surat.",
        "en": "Sure. Start with 'Sir/Madam,' and state the letter's purpose."
      },
      {
        "role": "learner",
        "ms": "Macam mana nak rujuk kepada aduan yang saya buat sebelum ni?",
        "en": "How do I refer to a complaint I made before?"
      },
      {
        "role": "coach",
        "ms": "Guna 'merujuk kepada aduan bertarikh...' dan nyatakan tarikh.",
        "en": "Use 'with reference to the complaint dated...' and state the date."
      },
      {
        "role": "coach",
        "ms": "Akhiri dengan kesimpulan jelas dan 'Yang benar,'.",
        "en": "End with a clear conclusion and 'Yours faithfully,'."
      }
    ],
    "aiPrompt": "You are an AI writing coach helping the learner draft a formal Malay letter. Give clear, structured guidance on openings, reference phrases, and closings. Be encouraging and specific."
  },
