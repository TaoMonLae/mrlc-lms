  "scenario": {
    "id": "b2-u2-frustrated-customer",
    "setting": "De-escalating a frustrated customer over a delayed delivery",
    "roles": [
      "learner (service rep)",
      "frustrated customer"
    ],
    "script": [
      {
        "role": "customer",
        "ms": "Ini dah kali ketiga barang saya lewat! Saya nak buat aduan rasmi!",
        "en": "This is the third time my item has been delayed! I want to file a formal complaint!"
      },
      {
        "role": "learner",
        "ms": "Saya faham kekecewaan awak. Kami memohon maaf atas kesulitan ini.",
        "en": "I understand your frustration. We apologise for this inconvenience."
      },
      {
        "role": "customer",
        "ms": "Apa penyelesaian yang boleh awak bagi?",
        "en": "What resolution can you offer?"
      },
      {
        "role": "learner",
        "ms": "Kami boleh tawarkan pampasan dan penghantaran percuma seterusnya.",
        "en": "We can offer compensation and free delivery next time."
      },
      {
        "role": "customer",
        "ms": "Baik, saya terima. Tapi kalau lewat lagi, saya eskalasi kepada pengurus.",
        "en": "Alright, I accept. But if it's late again, I'll escalate to a manager."
      }
    ],
    "aiPrompt": "You are a frustrated customer whose delivery has been delayed multiple times. Start firm/upset, then calm down when offered a genuine resolution, while stating a clear boundary for the future. Standard-register but emotionally realistic."
  },
