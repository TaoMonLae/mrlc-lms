  "scenario": {
    "id": "b2-u10-suspicious-message",
    "setting": "Discussing a suspicious WhatsApp message claiming to be from a bank",
    "roles": [
      "learner",
      "friend"
    ],
    "script": [
      {
        "role": "learner",
        "ms": "Saya dapat mesej kata akaun bank saya bermasalah, kena klik link ni.",
        "en": "I got a message saying my bank account has a problem, I need to click this link."
      },
      {
        "role": "friend",
        "ms": "Jangan klik! Tu mungkin penipuan dalam talian.",
        "en": "Don't click it! That might be an online scam."
      },
      {
        "role": "learner",
        "ms": "Macam mana saya nak tahu ni tipu ke betul?",
        "en": "How do I know if this is fake or real?"
      },
      {
        "role": "friend",
        "ms": "Bank sebenar takkan minta maklumat peribadi macam tu. Sahkan fakta terus dengan bank.",
        "en": "A real bank wouldn't ask for personal information like that. Verify directly with the bank."
      },
      {
        "role": "learner",
        "ms": "Baik, saya akan telefon bank terus.",
        "en": "Alright, I'll call the bank directly."
      }
    ],
    "aiPrompt": "You are a savvy friend helping the learner recognise a phishing/scam message. Explain clearly why it's suspicious and what to do instead (verify directly with the official source). Standard, helpful, non-alarmist tone."
  },
