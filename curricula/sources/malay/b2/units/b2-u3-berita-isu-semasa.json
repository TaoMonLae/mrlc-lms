  "scenario": {
    "id": "b2-u3-discussing-news",
    "setting": "Discussing a news story about rising living costs with a colleague",
    "roles": [
      "learner",
      "colleague"
    ],
    "script": [
      {
        "role": "colleague",
        "ms": "Awak dengar berita pasal kenaikan harga tak?",
        "en": "Did you hear the news about the price increase?"
      },
      {
        "role": "learner",
        "ms": "Ya, menurut laporan, ia akan mempengaruhi ramai keluarga.",
        "en": "Yes, according to the report, it will affect many families."
      },
      {
        "role": "colleague",
        "ms": "Pendapat umum nampak berbeza-beza kan?",
        "en": "Public opinion seems divided, right?"
      },
      {
        "role": "learner",
        "ms": "Betul. Tapi secara keseluruhan, ramai risau pasal kos sara hidup.",
        "en": "Right. But overall, many are worried about the cost of living."
      },
      {
        "role": "colleague",
        "ms": "Dikatakan kerajaan akan umumkan bantuan baru minggu depan.",
        "en": "It's said the government will announce new aid next week."
      }
    ],
    "aiPrompt": "You are a colleague discussing a current news topic (rising cost of living) at a natural, informed but non-partisan level. Use reporting language (menurut, dikatakan) and share a balanced view. Avoid taking one-sided political positions."
  },
