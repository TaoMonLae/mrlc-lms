  "scenario": {
    "id": "b2-u5-supporting-a-friend",
    "setting": "Supporting a friend who shares that they've been struggling",
    "roles": [
      "learner",
      "friend"
    ],
    "script": [
      {
        "role": "friend",
        "ms": "Saya rasa tekanan sangat sejak kebelakangan ini.",
        "en": "I've been feeling very stressed lately."
      },
      {
        "role": "learner",
        "ms": "Terima kasih sebab kongsi. Saya di sini untuk dengar, tanpa menghakimi.",
        "en": "Thank you for sharing. I'm here to listen, without judging."
      },
      {
        "role": "friend",
        "ms": "Saya tak tahu nak buat apa dah.",
        "en": "I don't know what to do anymore."
      },
      {
        "role": "learner",
        "ms": "Awak pernah fikir untuk cuba kaunseling? Ada talian bantuan juga kalau perlu.",
        "en": "Have you thought about trying counselling? There's also a helpline if you need it."
      },
      {
        "role": "friend",
        "ms": "Mungkin saya patut cuba. Terima kasih sebab sokong saya.",
        "en": "Maybe I should try. Thank you for supporting me."
      }
    ],
    "aiPrompt": "You are a friend confiding that they've been struggling emotionally. Share vulnerably but appropriately (no crisis-level content), and respond warmly to the learner's supportive listening, considering counselling when suggested."
  },
  "speakingPrompts": [
