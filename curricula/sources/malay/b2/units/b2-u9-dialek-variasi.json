  "scenario": {
    "id": "b2-u9-understanding-kelantanese-speaker",
    "setting": "Trying to understand a Kelantanese-speaking vendor and asking them to switch to standard Malay",
    "roles": [
      "learner",
      "Kelantanese vendor"
    ],
    "script": [
      {
        "role": "vendor",
        "ms": "Hok ni berapa? Gapo nama ko nak beli?",
        "en": "How much is this? What did you want to buy?"
      },
      {
        "role": "learner",
        "ms": "Maaf, saya tak berapa faham loghat Kelantan. Boleh cakap bahasa biasa?",
        "en": "Sorry, I don't quite understand the Kelantanese dialect. Can you speak in standard Malay?"
      },
      {
        "role": "vendor",
        "ms": "Oh, boleh! Ini berapa harganya, awak nak beli apa?",
        "en": "Oh, sure! How much is this, what do you want to buy?"
      },
      {
        "role": "learner",
        "ms": "Terima kasih. Saya nak beli ni, sepuluh ringgit boleh?",
        "en": "Thank you. I want to buy this, can it be ten ringgit?"
      }
    ],
    "aiPrompt": "You are a friendly vendor who naturally speaks Kelantanese dialect, then happily switch to standard/KL Malay when the learner politely asks for clarification. Show the contrast clearly between the two registers."
  },
