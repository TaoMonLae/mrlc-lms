  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one gold action per view.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><line x1=\"19\" x2=\"19\" y1=\"8\" y2=\"14\"/><line x1=\"22\" x2=\"16\" y1=\"11\" y2=\"11\"/></svg>New registration</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 14px;border:1px solid #f2b84b;border-radius:4px;background:#f2b84b;color:#0c2538;font:600 14px/1 'IBM Plex Sans Variable','Geist Variable',system-ui,sans-serif;cursor:pointer;transition:background-color .15s,border-color .15s,transform .15s}.ds-btn-primary:hover{background:#e97961;border-color:#e97961}.ds-btn-primary:focus-visible{outline:none;border-color:#168c83;box-shadow:0 0 0 2px rgba(22,140,131,.35)}.ds-btn-primary:active{transform:translateY(1px)}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary actions; inverts to ink on hover.",
      "html": "<button class=\"ds-btn-outline\">Reports</button>",
      "css": ".ds-btn-outline{height:40px;padding:0 14px;border:1px solid rgba(16,27,39,.25);border-radius:4px;background:#fff;color:#101b27;font:600 14px/1 'IBM Plex Sans Variable','Geist Variable',system-ui,sans-serif;cursor:pointer;transition:background-color .15s,color .15s,border-color .15s}.ds-btn-outline:hover{background:#101b27;border-color:#101b27;color:#f0f1ec}.ds-btn-outline:focus-visible{outline:none;border-color:#168c83;box-shadow:0 0 0 2px rgba(22,140,131,.35)}"
    },
    {
      "name": "Link Button",
      "kind": "button",
      "refersTo": "button-link",
      "description": "Teal tracked ledger link, e.g. 'View all'.",
      "html": "<a href=\"#\" class=\"ds-link\">View all</a>",
      "css": ".ds-link{display:inline-flex;align-items:center;min-height:40px;color:#168c83;font:600 12px/1 'IBM Plex Sans Variable','Geist Variable',system-ui,sans-serif;letter-spacing:.08em;text-transform:uppercase;text-decoration:none}.ds-link:hover{color:#101b27}.ds-link:focus-visible{outline:2px solid #168c83;outline-offset:2px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "40px flat field with teal focus.",
      "html": "<input class=\"ds-input\" placeholder=\"Student name\" />",
      "css": ".ds-input{height:40px;width:260px;padding:4px 12px;border:1px solid #c4cbc8;border-radius:4px;background:#fff;color:#101b27;font:400 14px/1.5 'IBM Plex Sans Variable','Geist Variable',system-ui,sans-serif;transition:border-color .15s}.ds-input::placeholder{color:#5d6a72}.ds-input:focus-visible{outline:none;border-color:#168c83;box-shadow:0 0 0 2px rgba(22,140,131,.3)}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Uppercase tinted status tag.",
      "html": "<span class=\"ds-badge\">Present</span> <span class=\"ds-badge ds-badge-priority\">Follow up</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;height:20px;padding:2px 8px;border-radius:4px;background:#dcefeb;color:#126a65;font:600 10px/1 'IBM Plex Sans Variable','Geist Variable',system-ui,sans-serif;letter-spacing:.07em;text-transform:uppercase}.ds-badge-priority{background:#fbe4de;color:#9a3a26}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-row",
      "description": "The navy spine with mint active line.",
      "html": "<nav class=\"ds-nav\"><div class=\"ds-nav-head\">School</div><a class=\"ds-nav-row is-active\" href=\"#\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\"/></svg>Dashboard</a><a class=\"ds-nav-row\" href=\"#\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z\"/><path d=\"M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z\"/></svg>Exams</a></nav>",
      "css": ".ds-nav{width:240px;padding:16px 10px;background:#102b3b;font-family:'IBM Plex Sans Variable','Geist Variable',system-ui,sans-serif}.ds-nav-head{padding:0 8px 10px;color:#91a9b7;font-size:10px;letter-spacing:.09em;text-transform:uppercase}.ds-nav-row{position:relative;display:flex;align-items:center;gap:10px;height:36px;padding:0 10px;border-radius:6px;color:#bdcdd7;font-size:13px;font-weight:450;text-decoration:none;transition:background .15s,color .15s}.ds-nav-row svg{color:#8fa9ba}.ds-nav-row:hover{background:rgba(255,255,255,.035);color:#fff}.ds-nav-row.is-active{background:#244b56;color:#d6fff4}.ds-nav-row.is-active svg{color:#9de1d0}.ds-nav-row.is-active::before{content:'';position:absolute;left:0;top:9px;bottom:9px;width:2px;border-radius:2px;background:#83d8c1}.ds-nav-row:focus-visible{outline:2px solid #e8bd5e;outline-offset:2px}"
    },
    {
      "name": "Ledger Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat sheet with a dark-ruled header and teal micro-label.",
      "html": "<section class=\"ds-ledger\"><header class=\"ds-ledger-head\"><div><p class=\"ds-kicker\">Today</p><h3>Notice board</h3></div><a href=\"#\">View all</a></header><p class=\"ds-ledger-body\">Grade 10 mock exam moved to Thursday, 9:00.</p></section>",
      "css": ".ds-ledger{width:360px;border:1px solid #cfd5d2;background:#fff;color:#172033;font-family:'IBM Plex Sans Variable','Geist Variable',system-ui,sans-serif}.ds-ledger-head{display:flex;align-items:flex-end;justify-content:space-between;padding:16px 20px 12px;border-bottom:1px solid #101b27}.ds-kicker{margin:0;color:#168c83;font-size:10px;font-weight:600;letter-spacing:.14em;text-transform:uppercase}.ds-ledger-head h3{margin:4px 0 0;font-size:18px;font-weight:600;letter-spacing:-.02em}.ds-ledger-head a{color:#168c83;font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;text-decoration:none}.ds-ledger-head a:hover{color:#101b27}.ds-ledger-body{margin:0;padding:16px 20px;font-size:14px;line-height:1.5}"
    },
    {
      "name": "Field Note with Priority Block",
      "kind": "custom",
      "refersTo": "field-note",
      "description": "Signature dashboard opener: navy-bordered sheet with a coral priority count.",
      "html": "<div class=\"ds-fieldnote\"><div class=\"ds-fn-main\"><p class=\"ds-fn-kicker\">Tuesday field note</p><h2>Three classes still need attendance.</h2></div><div class=\"ds-fn-priority\"><p class=\"ds-fn-kicker2\">Needs attention</p><strong>07</strong><span>open cases</span></div></div>",
      "css": ".ds-fieldnote{display:grid;grid-template-columns:minmax(0,1fr) 220px;border:1px solid #0c2538;background:#fff;font-family:'IBM Plex Sans Variable','Geist Variable',system-ui,sans-serif}.ds-fn-main{padding:28px}.ds-fn-kicker,.ds-fn-kicker2{margin:0;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase}.ds-fn-kicker{color:#168c83}.ds-fn-main h2{margin:12px 0 0;color:#101b27;font-size:34px;font-weight:600;line-height:.98;letter-spacing:-.04em}.ds-fn-priority{display:flex;flex-direction:column;justify-content:space-between;padding:24px;background:#e97961;color:#0c2538}.ds-fn-priority strong{font-size:64px;font-weight:600;line-height:1;letter-spacing:-.07em;font-variant-numeric:tabular-nums}.ds-fn-priority span{font-size:12px;font-weight:600;letter-spacing:.16em;text-transform:uppercase}"
    }
  ],
  "narrative": {
    "northStar": "School Operations Fieldbook",
    "overview": "MRLC LMS is a working school's record book. Each screen should read like a well-kept ledger page: pale paper, white sheets laid on it, hairline rules where a ledger would rule, and one dark navy spine down the side. Depth comes from rules and hierarchy, not from floating cards, glows or gradients. The system was locked on 31 August 2026 ([docs/ui/REFERO-UI-AUDIT.md](docs/ui/REFERO-UI-AUDIT.md)). It replaced a generic grid of rounded, shadowed cards with purple gradients, and that look is the confirmed anti-reference.\n\nThe density is operational. Staff move through attendance, exams, fees and cases all day, so controls are 40px tall, text is compact, and pages are connected strips and tables, not tiles of equal weight. Personality comes from precise details: tight display type with negative tracking, uppercase micro-labels in teal, a coral block that marks what needs attention today, and the gold button that means \"do this\".\n\nBurmese and Mon text uses the same system. The ledger structure stays the same, but line heights open up so stacked Myanmar-script glyphs never clip.",
    "keyCharacteristics": [
      "Flat paper and sheet surfaces, with 1px rules instead of shadows",
      "Low, square corners (4px by default, 0 on ruled forms)",
      "Every color has one job: gold for the primary action, teal for selection and links, coral for priority, navy for structure",
      "IBM Plex Sans throughout, with tabular numerals",
      "A navy spine that stays fixed in light and dark themes",
      "Light theme by default, with a layered blue-grey dark theme (never pure black)"
    ],
    "rules": [
