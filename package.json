{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "seed:en-my-dictionary": "tsx prisma/seedEnMyDictionary.ts",
    "seed:mon-dictionary": "tsx prisma/seedMonDictionary.ts",
    "seed:chinese-dictionary": "tsx prisma/seedChineseDictionary.ts",
    "generate:language-quest-chinese": "node scripts/generate-language-quest-chinese-course.mjs",
    "generate:language-quest-english-words": "node scripts/generate-language-quest-english-word-courses.mjs",
    "generate:language-quest-advanced-english": "node scripts/generate-language-quest-advanced-english-courses.mjs",
    "generate:language-quest-linguify": "node scripts/generate-language-quest-linguify-courses.mjs",
    "generate:language-quest-malay": "node scripts/generate-language-quest-malay-courses.mjs",
    "generate:language-quest-malay-speaking": "node scripts/generate-language-quest-malay-speaking-course.mjs",
    "generate:language-quest-malay-guide": "node scripts/generate-language-quest-malay-guide-course.mjs",
    "generate:language-quest-teach-yourself-malay": "node scripts/generate-language-quest-teach-yourself-malay.mjs",
    "generate:language-quest-k12-math": "node scripts/generate-language-quest-k12-math-courses.mjs",
    "voice:kokoro": "Kokoro/.venv/bin/python scripts/kokoro_language_quest_api.py --host 127.0.0.1 --port 8810 --device auto",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --minify-syntax --minify-whitespace --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
