# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/school_lms"

# Secret used to sign auth tokens. MUST be a long, random string (>= 16 chars).
# Generate one with:  openssl rand -base64 48
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Public origin of the app (used for CORS). Set to your real https:// URL in prod.
APP_URL="http://localhost:8000"

# ── Optional ──────────────────────────────────────────────────────────────────

# Port the server listens on (default 8000).
PORT="8000"

# SMTP is required for password-reset links and optional email notifications.
# Port 465 normally uses SMTP_SECURE=true; port 587 normally uses false.
# SMTP_HOST="smtp.example.org"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="MRLC LMS <no-reply@example.org>"

# Where uploaded e-books (EPUB/PDF) are stored on disk. Use a persistent volume.
EBOOK_DIR="./data/ebooks"
VIDEO_FILES_DIR="./data/videos"

# Database backups (pg_dump). Use a persistent volume; keep the last N.
BACKUP_DIR="./data/backups"
BACKUP_RETENTION="14"
# Local hour (0-23) for the daily automatic backup (runs only when enabled in Settings).
BACKUP_HOUR="2"
# Optional second directory for an automatic copy of every backup artifact.
# Mount this path to separate storage in production; do not point it inside BACKUP_DIR.
# OFFSITE_BACKUP_DIR="/mnt/offsite/mrlc-backups"

# Seed credentials. If set, the seed uses these and the account is NOT forced to
# change password. If unset, demo defaults are used and a password change is
# forced on first login. Never rely on demo defaults in production.
# SEED_ADMIN_PASSWORD=""
# SEED_TEACHER_PASSWORD=""
# SEED_STUDENT_PASSWORD=""

# ── AI Configuration (Optional) ───────────────────────────────────────────────
# AI provider: "gemini" (Google Cloud API) or "ollama" (local offline Gemma 2)
AI_PROVIDER="gemini"

# For Gemini API (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-flash-latest"

# For Local Ollama (Download from https://ollama.com/)
OLLAMA_API_URL="http://localhost:11434/api/chat"
OLLAMA_MODEL="gemma2:9b"

# Optional built-in Language Quest speech. Keep the VoxCPM service bound to
# localhost and expose it to learners only through the authenticated LMS API.
# Leave unset to use the browser's installed speech voices.
# VOXCPM_API_URL="http://127.0.0.1:8810"
# VOXCPM_MODEL="openbmb/VoxCPM2"
# VOXCPM_VOICE="A warm, clear teacher voice with patient pronunciation and a friendly pace"
# VOXCPM_TIMEOUT_MS="120000"
